{
  "name": "entinygram",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup": "bun assets/scripts/setup.ts",
    "generate-icons": "bun assets/scripts/generate-icons.ts",
    "generate-icon-packs": "bun assets/scripts/generate-icon-packs.ts",
    "preview-icons": "bun assets/scripts/preview-icons.ts",
    "generate-tl": "bun assets/scripts/generate-tl.ts",
    "export": "bun assets/scripts/export.ts",
    "rebase": "bun assets/scripts/rebase.ts",
    "lint-patches": "bun assets/scripts/lint-patches.ts",
    "entinychecker": "bun assets/scripts/entinychecker.ts",
    "push-theme": "bun assets/scripts/push-theme.ts",
    "check-translations": "bun assets/scripts/check-translations.ts",
    "gradle": "bun assets/scripts/gradle.ts",
    "build-debug": "bun assets/scripts/generate-grants.ts && bun assets/scripts/gradle.ts TMessagesProj_App:assembleDebug",
    "run-debug": "bun assets/scripts/gradle.ts TMessagesProj_App:installDebug && adb shell am start ua.entaytion.entinygram/org.telegram.ui.LaunchActivity",
    "check-plugin-syntax": "for f in src/test/plugins/*.js $(find src/native/src -name '*.js'); do node --check \"$f\" || exit 1; done",
    "typecheck-plugins": "bun run check-plugin-syntax && bun assets/scripts/generate-tl.ts && bun assets/scripts/generate-grants.ts && tsc -p sdk/types/tsconfig.self.json --noEmit && tsc -p src/test/plugins --noEmit",
    "prepare": "husky",
    "generate-grants": "bun assets/scripts/generate-grants.ts",
    "changelog:release": "bun assets/release/changelog.ts"
  },
  "dependencies": {
    "@antfu/eslint-config": "^8.1.0",
    "@fuman/utils": "^0.0.19",
    "@iconify/json": "^2.2.554",
    "@mtcute/node": "^0.31.0",
    "eslint": "^10.2.0",
    "tinyglobby": "^0.2.16",
    "zx": "^8.8.4",
    "@inugram/plugin-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "@types/proper-lockfile": "^4.1.4",
    "husky": "^9.1.7",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "sdk/*"
  ]
}
