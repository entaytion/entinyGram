             });
             popupLayout.addView(sendMsgCell);
 
+            ActionBarMenuSubItem openProfileCell = new ActionBarMenuSubItem(context, false, false);
+            openProfileCell.setColors(Theme.getColor(Theme.key_actionBarDefaultSubmenuItem, resourcesProvider), Theme.getColor(Theme.key_actionBarDefaultSubmenuItemIcon, resourcesProvider));
+            openProfileCell.setSelectorColor(Theme.getColor(Theme.key_dialogButtonSelector, resourcesProvider));
+            openProfileCell.setTextAndIcon(LocaleController.getString(R.string.OpenProfile), R.drawable.msg_openprofile);
+            openProfileCell.setOnClickListener((v) -> {
