From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alina sireneva <alina@tei.pet>
Date: Wed, 26 Aug 2026 22:50:49 +0300
Subject: local overrides for forum topics view

---
 .../src/main/java/org/telegram/messenger/ChatObject.java      | 4 ++++
 .../src/main/java/org/telegram/messenger/MessagesStorage.java | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ChatObject.java b/TMessagesProj/src/main/java/org/telegram/messenger/ChatObject.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/ChatObject.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ChatObject.java
@@ -2628,6 +2628,10 @@ public class ChatObject {
     }
 
     public static boolean areTabsEnabled(TLRPC.Chat chat) {
+        final int inuOverride = chat == null ? 0 : desu.inugram.helpers.chat.ForumDisplayHelper.getOverride(chat.id);
+        if (inuOverride != 0) {
+            return inuOverride == desu.inugram.helpers.chat.ForumDisplayHelper.MODE_TABS;
+        }
         return SharedConfig.forceForumTabs || chat != null && chat.forum_tabs;
     }
 }
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java
@@ -19083,7 +19083,7 @@ public class MessagesStorage extends BaseController {
                 TLRPC.Chat chat = getChat(-dialogId);
                 if (chat != null && chat.forum) {
                     value |= FORUM_TYPE_CHAT;
-                    if (chat.forum_tabs) {
+                    if (ChatObject.areTabsEnabled(chat)) {
                         value |= FORUM_TYPE_CHAT_TABS;
                     }
                 }
