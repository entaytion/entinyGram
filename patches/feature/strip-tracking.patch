index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/browser/Browser.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/browser/Browser.java
@@ -289,9 +289,17 @@ public class Browser {
     }
 
     public static void openUrl(final Context context, Uri uri, boolean _allowCustom, boolean tryTelegraph, boolean forceNotInternalForApps, Progress inCaseLoading, String browser, boolean allowIntent, boolean allowInAppBrowser, boolean forceRequest) {
+        if (context != null && uri != null && desu.inugram.helpers.UrlCleanerHelper.openResolvingRedirects(context, uri, inCaseLoading, resolved -> inu_openUrl(context, resolved, _allowCustom, tryTelegraph, forceNotInternalForApps, null, browser, allowIntent, allowInAppBrowser, forceRequest))) {
+            return;
+        }
+        inu_openUrl(context, uri, _allowCustom, tryTelegraph, forceNotInternalForApps, inCaseLoading, browser, allowIntent, allowInAppBrowser, forceRequest);
+    }
+
+    private static void inu_openUrl(final Context context, Uri uri, boolean _allowCustom, boolean tryTelegraph, boolean forceNotInternalForApps, Progress inCaseLoading, String browser, boolean allowIntent, boolean allowInAppBrowser, boolean forceRequest) {
         if (context == null || uri == null) {
             return;
         }
+        uri = desu.inugram.helpers.UrlCleanerHelper.clean(uri);
         final int currentAccount = UserConfig.selectedAccount;
         boolean[] forceBrowser = new boolean[]{false};
         boolean internalUri = isInternalUri(uri, forceBrowser);
