+    public static class CachedToSpan {
+        public int group;
+        public int start, end;
+
+        public CachedToSpan(int group, int start, int end) {
+            this.group = group;
+            this.start = start;
+            this.end = end;
+        }
+    }
+
+    public static void inu_computeSpans(
+            String source, String language, Utilities.Callback<ArrayList<CachedToSpan>> whenDone) {
+        if (whenDone == null) return;
+        String normalized = PrismaHighlightingService.normalizeLanguage(language);
+        if (normalized.isEmpty() || source == null || source.isEmpty()) {
+            whenDone.run(new ArrayList<>());
+            return;
+        }
+        SERVICE.request(
+                source,
+                normalized,
+                answer -> {
+                    ArrayList<CachedToSpan> spans = new ArrayList<>();
+                    if (answer.tokens != null) {
+                        int[] ranges = answer.tokens.styledRanges();
+                        for (int i = 0; i + 2 < ranges.length; i += 3) {
+                            int group = ranges[i + 2] & PrismaTokenStyles.COLOR_MASK;
+                            if (group != 0 && ranges[i] < ranges[i + 1]) {
+                                spans.add(new CachedToSpan(group, ranges[i], ranges[i + 1]));
+                            }
+                        }
+                    }
+                    whenDone.run(spans);
+                });
+    }
+
