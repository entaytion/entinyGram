+    @Override
+    public Resources getResources() {
+        Resources baseResources = super.getResources();
+        if (desu.inugram.InuConfig.ICON_PACKS.getValue().isEmpty()) {
+            return baseResources;
+        }
+        if (customResources == null || !customResources.wrapsResources(baseResources)) {
+            customResources = new desu.inugram.helpers.icons.IconsResources(baseResources);
+        }
+        return customResources;
+    }
