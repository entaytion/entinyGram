-                    if (hit.supportsAnimate != 0) {
+                    if (hit.supportsAnimate != 0 && (desu.inugram.InuConfig.ICON_PACKS.getValue().isEmpty() || desu.inugram.helpers.icons.IconPackHelper.isLottieReplaced(hit.supportsAnimate))) {
                         hit.updateDrawable(true, hit.supportsAnimate);
