+    @Override
+    public Resources getResources() {
+        Resources baseResources = super.getResources();
+        if (desu.inugram.InuConfig.ICON_REPLACEMENT.getValue() == desu.inugram.InuConfig.IconReplacementItem.OFF) {
+            return baseResources;
