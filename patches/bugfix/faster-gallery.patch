+    public void inu_reloadCurrentPhoto(MediaController.PhotoEntry entry, boolean reloadImage) {
+        if (currentEditMode != EDIT_MODE_NONE || currentIndex < 0 || currentIndex >= imagesArrLocals.size() || !(imagesArrLocals.get(currentIndex) instanceof MediaController.PhotoEntry)) {
+            android.util.Log.d("inu-gallery", "inu_reloadCurrentPhoto: skipped, editMode=" + currentEditMode + " index=" + currentIndex);
