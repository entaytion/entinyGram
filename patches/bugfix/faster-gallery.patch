+        android.util.Log.d("inu-gallery", "inu_reloadCurrentPhoto: entry id=" + entry.imageId + " reloadImage=" + reloadImage);
+        applyCaption();
+        MediaController.PhotoEntry previous = (MediaController.PhotoEntry) imagesArrLocals.get(currentIndex);
+        if (entry != previous) {
+            entry.copyFrom(previous);
+            imagesArrLocals.set(currentIndex, entry);
+        }
+        if (reloadImage) {
+            String key = centerImage.getImageKey();
+            if (key != null) {
+                ImageLoader.getInstance().removeImage(key);
+            }
+            centerImage.clearImage();
+            setImageIndex(currentIndex, false, false, true);
+        }
+    }
