+    public void inu_markMessageReactionsAsRead(long dialogId, long topicId, int messageId) {
+        getMessagesStorage().markMessageReactionsAsRead(dialogId, topicId, messageId);
+        if (messageId <= 0 || DialogObject.isEncryptedDialog(dialogId)) {
+            return;
+        }
+        final boolean debug = desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled();
+        if (debug) {
+            FileLog.d("InuRx report read did=" + dialogId + " topic=" + topicId + " mid=" + messageId + " from " + desu.inugram.helpers.chat.ReactionDebugHelper.caller());
+        }
+        final TLObject request;
+        TLRPC.Chat chat = DialogObject.isChatDialog(dialogId) ? getChat(-dialogId) : null;
+        if (ChatObject.isChannel(chat)) {
+            TLRPC.TL_channels_readMessageContents req = new TLRPC.TL_channels_readMessageContents();
+            req.channel = getInputChannel(chat);
+            req.id.add(messageId);
+            request = req;
+        } else {
+            TLRPC.TL_messages_readMessageContents req = new TLRPC.TL_messages_readMessageContents();
+            req.id.add(messageId);
+            request = req;
+        }
+        final String key = dialogId + "_" + messageId;
+        inu_pendingReactionReads.merge(key, 1, Integer::sum);
+        getConnectionsManager().sendRequest(request, (response, error) -> {
+            inu_pendingReactionReads.computeIfPresent(key, (k, v) -> v > 1 ? v - 1 : null);
+            if (debug) {
+                FileLog.d("InuRx report read result did=" + dialogId + " mid=" + messageId + " error=" + (error == null ? null : error.text));
+            }
+            if (response instanceof TLRPC.TL_messages_affectedMessages) {
+                TLRPC.TL_messages_affectedMessages res = (TLRPC.TL_messages_affectedMessages) response;
+                processNewDifferenceParams(-1, res.pts, -1, res.pts_count);
+            }
+        });
+    }
+
+    public void inu_ignorePendingReadReactions(long dialogId, int messageId, TLRPC.MessageReactions reactions) {
+        if (reactions == null || reactions.recent_reactions == null || !inu_pendingReactionReads.containsKey(dialogId + "_" + messageId)) {
+            return;
+        }
+        boolean changed = false;
+        for (int i = 0; i < reactions.recent_reactions.size(); i++) {
+            TLRPC.MessagePeerReaction reaction = reactions.recent_reactions.get(i);
+            if (reaction.unread) {
+                reaction.unread = false;
+                changed = true;
+            }
+        }
+        if (changed && desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled()) {
+            FileLog.d("InuRx ignored unread flags pending read did=" + dialogId + " mid=" + messageId + " from " + desu.inugram.helpers.chat.ReactionDebugHelper.caller());
+        }
+    }
