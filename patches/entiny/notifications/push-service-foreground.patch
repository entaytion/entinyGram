@@ -8,21 +8,50 @@
 
 package org.telegram.messenger;
 
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
 import android.app.Service;
+import android.content.Context;
 import android.content.Intent;
 import android.content.SharedPreferences;
+import android.os.Build;
 import android.os.IBinder;
 
+import androidx.core.app.NotificationCompat;
+
 public class NotificationsService extends Service {
 
+    private static final int inu_notificationId = 9999;
+    private static final String inu_channelId = "push_service_channel";
+
+    private static volatile boolean inu_foregroundStartPending;
+    private static volatile boolean inu_stopWhenForeground;
+    private Notification inu_notification;
+
+    public static void inu_onForegroundStartRequested() {
+        inu_stopWhenForeground = false;
+        inu_foregroundStartPending = true;
+    }
+
+    public static boolean inu_isForegroundStartPending() {
+        return inu_foregroundStartPending;
+    }
+
+    public static void inu_requestStopWhenForeground() {
+        inu_stopWhenForeground = true;
+    }
+
     @Override
     public void onCreate() {
         super.onCreate();
+        inu_moveToForeground();
         ApplicationLoader.postInitApplication();
     }
 
     @Override
     public int onStartCommand(Intent intent, int flags, int startId) {
+        inu_moveToForeground();
         return START_STICKY;
     }
 
@@ -33,6 +62,8 @@ public class NotificationsService extends Service {
 
     public void onDestroy() {
         super.onDestroy();
+        inu_foregroundStartPending = false;
+        inu_stopWhenForeground = false;
         SharedPreferences preferences = MessagesController.getGlobalNotificationsSettings();
         if (preferences.getBoolean("pushService", true)) {
             Intent intent = new Intent("org.telegram.start");
@@ -40,4 +71,37 @@ public class NotificationsService extends Service {
             sendBroadcast(intent);
         }
     }
+
+    private void inu_moveToForeground() {
+        if (!desu.inugram.helpers.NotificationsHelper.keepAliveForeground()) {
+            inu_foregroundStartPending = false;
+            return;
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            try {
+                startForeground(inu_notificationId, inu_getNotification());
+            } catch (Throwable ignore) {
+
+            }
+        }
+        inu_foregroundStartPending = false;
+        if (inu_stopWhenForeground) {
+            stopSelf();
+        }
+    }
+
+    private Notification inu_getNotification() {
+        if (inu_notification == null) {
+            NotificationManager notificationManager = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
+            notificationManager.createNotificationChannel(new NotificationChannel(inu_channelId, LocaleController.getString(R.string.NotificationsService), NotificationManager.IMPORTANCE_LOW));
+            inu_notification = new NotificationCompat.Builder(this, inu_channelId)
+                    .setShowWhen(false)
+                    .setOngoing(true)
+                    .setSmallIcon(desu.inugram.helpers.NotificationsHelper.smallIconRes())
+                    .setContentTitle(LocaleController.getString(R.string.NotificationsService))
+                    .setContentText(LocaleController.getString(R.string.NotificationsServiceInfo))
+                    .build();
+        }
+        return inu_notification;
+    }
 }
