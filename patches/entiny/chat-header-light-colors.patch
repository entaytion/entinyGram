+            color = desu.inugram.helpers.theme.ChatHeaderThemeHelper.getLightHeaderColor(key, color);
+        }
+        return color;
     }
 
     public void updateColors() {
+        if (titleTextView != null) {
+            titleTextView.setTextColor(getThemedColor(Theme.key_actionBarDefaultTitle));
+        }
+        if (subtitleTextView != null) {
+            subtitleTextView.setTextColor(getThemedColor(lastSubtitleColorKey >= 0 ? lastSubtitleColorKey : Theme.key_actionBarDefaultSubtitle));
+        }
+        if (animatedSubtitleTextView != null) {
+            animatedSubtitleTextView.setTextColor(getThemedColor(lastSubtitleColorKey >= 0 ? lastSubtitleColorKey : Theme.key_actionBarDefaultSubtitle));
+        }
         if (currentTypingDrawable != null) {
