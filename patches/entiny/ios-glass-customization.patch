-            searchTabBackground = iBlur3FactoryGlass.create(searchTabButton, BlurredBackgroundProviderImpl.mainTabs(resourceProvider));
+            searchTabBackground = iBlur3FactoryGlass.create(searchTabButton, BlurredBackgroundProviderImpl.inu_mainTabs(resourceProvider, MainTabsHelper.isIos()));
             searchTabBackground.setRadius(dp(26));
             searchTabBackground.setPadding(dp(0.334f));
             searchTabButton.setBackground(searchTabBackground);
