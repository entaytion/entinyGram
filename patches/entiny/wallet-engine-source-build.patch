From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alina sireneva <alina@tei.pet>
Date: Tue, 3 Nov 2026 18:33:11 +0400
Subject: build patched wallet-engine from source

---
 TMessagesProj/build.gradle                    | 24 +++++++++++++++++++
 TMessagesProj/jni/CMakeLists.txt              |  4 ++--
 .../jni/prebuild/build_wallet_engine.sh       | 20 ++++++++++++----
 TMessagesProj/jni/prebuild/common.sh          | 16 +++++++++----
 4 files changed, 53 insertions(+), 11 deletions(-)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -193,6 +193,29 @@ def preprocessInuSources = tasks.register('preprocessInuSources') {
     }
 }
 
+// wallet-engine carries patches-native, so its committed prebuilt archive and bindings are stale
+def inuWalletEngineDir = layout.buildDirectory.dir('inuWalletEngine').get().asFile
+def buildInuWalletEngine = tasks.register('buildInuWalletEngine', Exec) {
+    def abis = android.defaultConfig.ndk.abiFilters.join(' ')
+    inputs.files(fileTree('jni/wallet-engine') { exclude '**/target/**', '.git' }, fileTree('jni/gram-wallet') { exclude 'target/**' },
+        'jni/prebuild/build_wallet_engine.sh', 'jni/prebuild/common.sh').withPathSensitivity(PathSensitivity.RELATIVE)
+    inputs.property('abis', abis)
+    inputs.property('ndk', android.ndkVersion)
+    outputs.dirs(new File(inuWalletEngineDir, 'lib'), new File(inuWalletEngineDir, 'include'))
+    outputs.cacheIf { true }
+    def userHome = System.getProperty('user.home')
+    environment 'PATH', [System.getenv('CARGO_HOME') ? "${System.getenv('CARGO_HOME')}/bin" : null, "$userHome/.cargo/bin", System.getenv('PATH')].findAll { it }.join(File.pathSeparator)
+    environment 'ANDROID_NDK_HOME', android.ndkDirectory.absolutePath
+    environment 'ABIS', abis
+    environment 'LIB_DIR', new File(inuWalletEngineDir, 'lib').absolutePath
+    environment 'INCLUDE_DIR', new File(inuWalletEngineDir, 'include').absolutePath
+    environment 'WALLET_ENGINE_BUILD_DIR', new File(inuWalletEngineDir, 'cargo').absolutePath
+    commandLine 'bash', file('jni/prebuild/build_wallet_engine.sh').absolutePath
+}
+tasks.matching { it.name.startsWith('configureCMake') || it.name.startsWith('buildCMake') }.configureEach {
+    dependsOn buildInuWalletEngine
+}
+
 android {
     compileSdk 36
     buildToolsVersion '36.0.0'
@@ -260,6 +283,7 @@ android {
             cmake {
                 version '3.22.1'
                 arguments '-DANDROID_STL=c++_static', '-DANDROID_PLATFORM=android-26' //, '-DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON'
+                arguments += ["-DINU_WALLET_ENGINE_DIR=${inuWalletEngineDir.absolutePath.replace(File.separator, '/')}"]
                 targets 'tmessages.49', 'twidget'
                 if (!rootProject.ext.inuPluginless) {
                     arguments += ['-DINU_EXPORT_SQLITE=ON']
diff --git a/TMessagesProj/jni/CMakeLists.txt b/TMessagesProj/jni/CMakeLists.txt
index 0000000..0000000 100644
--- a/TMessagesProj/jni/CMakeLists.txt
+++ b/TMessagesProj/jni/CMakeLists.txt
@@ -144,10 +144,10 @@ set_target_properties(tlottie PROPERTIES
         IMPORTED_LOCATION ${CMAKE_HOME_DIRECTORY}/prebuild/lib/${ANDROID_ABI}/libtlottie.a)
 
 # Wallet Engine: matching Rust archive and generated UniFFI C++20 wrapper.
-set(WALLET_ENGINE_INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/prebuild/include/wallet-engine)
+set(WALLET_ENGINE_INCLUDE_DIR ${INU_WALLET_ENGINE_DIR}/include/wallet-engine)
 add_library(wallet_engine STATIC IMPORTED)
 set_target_properties(wallet_engine PROPERTIES
-        IMPORTED_LOCATION ${CMAKE_CURRENT_SOURCE_DIR}/prebuild/lib/${ANDROID_ABI}/libwallet_engine.a)
+        IMPORTED_LOCATION ${INU_WALLET_ENGINE_DIR}/lib/${ANDROID_ABI}/libwallet_engine.a)
 
 add_library(wallet_engine_cpp STATIC
         ${WALLET_ENGINE_INCLUDE_DIR}/wallet_engine.cpp
diff --git a/TMessagesProj/jni/prebuild/build_wallet_engine.sh b/TMessagesProj/jni/prebuild/build_wallet_engine.sh
index 0000000..0000000 100755
--- a/TMessagesProj/jni/prebuild/build_wallet_engine.sh
+++ b/TMessagesProj/jni/prebuild/build_wallet_engine.sh
@@ -80,6 +80,7 @@ export CARGO_ENCODED_RUSTFLAGS
 case "$host_os" in
     Darwin) host_library=libgram_wallet.dylib ;;
     Linux) host_library=libgram_wallet.so ;;
+    Windows) host_library=gram_wallet.dll ;;
 esac
 echo "Generating Wallet Engine C++ bindings with $(rustc --version)"
 cargo rustc --manifest-path "$ADAPTER_DIR/Cargo.toml" \
@@ -102,8 +103,17 @@ for abi in $ABIS; do
         armeabi-v7a) clang_prefix=armv7a-linux-androideabi ;;
         *) clang_prefix="$target" ;;
     esac
-    linker="$NDK_TOOLCHAIN/bin/${clang_prefix}${API}-clang"
-    if [[ ! -x "$linker" ]]; then
+    clang="$NDK_TOOLCHAIN/bin/${clang_prefix}${API}-clang"
+    cxx="$NDK_TOOLCHAIN/bin/${clang_prefix}${API}-clang++"
+    linker="$clang"
+    ar="$NDK_TOOLCHAIN/bin/llvm-ar"
+    if [[ "$host_os" == Windows ]]; then
+        linker="$clang.cmd"
+        clang="$clang.cmd"
+        cxx="$cxx.cmd"
+        ar="$ar.exe"
+    fi
+    if [[ ! -f "$linker" ]]; then
         echo "ERROR: Android compiler not found: $linker" >&2
         exit 1
     fi
@@ -112,9 +122,9 @@ for abi in $ABIS; do
 
     echo "Building Wallet Engine: $abi (API $API)"
     env "CARGO_TARGET_${target_key}_LINKER=$linker" \
-        "CC_${cc_key}=$linker" \
-        "CXX_${cc_key}=${linker}++" \
-        "AR_${cc_key}=$NDK_TOOLCHAIN/bin/llvm-ar" \
+        "CC_${cc_key}=$clang" \
+        "CXX_${cc_key}=$cxx" \
+        "AR_${cc_key}=$ar" \
         cargo rustc --manifest-path "$ADAPTER_DIR/Cargo.toml" \
         --target-dir "$BUILD_DIR/android" --locked --release --lib \
         --target "$target" --crate-type staticlib
diff --git a/TMessagesProj/jni/prebuild/common.sh b/TMessagesProj/jni/prebuild/common.sh
index 0000000..0000000 100755
--- a/TMessagesProj/jni/prebuild/common.sh
+++ b/TMessagesProj/jni/prebuild/common.sh
@@ -24,6 +24,10 @@ case "$host_os" in
     Linux)
         DEFAULT_ANDROID_SDK_ROOT="$HOME/Android/Sdk"
         ;;
+    MINGW*|MSYS*|CYGWIN*)
+        host_os=Windows
+        DEFAULT_ANDROID_SDK_ROOT="$(cygpath -u "${LOCALAPPDATA:-$HOME/AppData/Local}/Android/Sdk")"
+        ;;
     *)
         echo "ERROR: unsupported host OS: $host_os" >&2
         return 1 2>/dev/null || exit 1
@@ -63,6 +67,9 @@ case "$host_os" in
                 ;;
         esac
         ;;
+    Windows)
+        NDK_HOST_TAG="windows-x86_64"
+        ;;
 esac
 NDK_TOOLCHAIN="$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/$NDK_HOST_TAG"
 
@@ -209,10 +216,11 @@ find_ndk_tool() {
     local tool_name="$1"
     local candidate
 
-    for candidate in "$ANDROID_NDK_HOME"/toolchains/llvm/prebuilt/*/bin/"$tool_name"; do
-        [[ -x "$candidate" ]] || continue
-        printf '%s\n' "$candidate"
-        return 0
+    for candidate in "$ANDROID_NDK_HOME"/toolchains/llvm/prebuilt/*/bin/"$tool_name" "$ANDROID_NDK_HOME"/toolchains/llvm/prebuilt/*/bin/"$tool_name.exe"; do
+        if [[ -x "$candidate" ]]; then
+            printf '%s\n' "$candidate"
+            return 0
+        fi
     done
 
     return 1
