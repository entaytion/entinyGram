From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Thu, 20 Aug 2026 01:30:08 +0300
Subject: Consolidate legacy self-destruct file-cache flag into SAVE_SELF_DESTRUCT_MEDIA

---
 .../src/main/java/org/telegram/messenger/FileLoader.java  | 8 ++++----
 .../main/java/org/telegram/messenger/MessageObject.java   | 4 ++--
 .../src/main/java/org/telegram/ui/ChatActivity.java       | 8 ++++----
 3 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java b/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java
@@ -1289,8 +1289,8 @@ public class FileLoader extends BaseController {
             }
         } else {
             if (MessageObject.getMedia(message) instanceof TLRPC.TL_messageMediaDocument) {
-                File res = getPathToAttach(MessageObject.getMedia(message).document, null, forceCache || (MessageObject.getMedia(message).ttl_seconds != 0 && !desu.inugram.InuConfig.SAVE_SELF_DESTRUCT.getValue()), useFileDatabaseQueue);
-                if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT.getValue() && !res.exists()) {
+                File res = getPathToAttach(MessageObject.getMedia(message).document, null, forceCache || (MessageObject.getMedia(message).ttl_seconds != 0 && !desu.inugram.InuConfig.SAVE_SELF_DESTRUCT_MEDIA.getValue()), useFileDatabaseQueue);
+                if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT_MEDIA.getValue() && !res.exists()) {
                     File cacheRes = getPathToAttach(MessageObject.getMedia(message).document, null, true, useFileDatabaseQueue);
                     if (cacheRes.exists()) return cacheRes;
                 }
@@ -1300,8 +1300,8 @@ public class FileLoader extends BaseController {
                 if (sizes.size() > 0) {
                     TLRPC.PhotoSize sizeFull = getClosestPhotoSizeWithSize(sizes, AndroidUtilities.getPhotoSize(true), false, null, true);
                     if (sizeFull != null) {
-                        File res = getPathToAttach(sizeFull, null, forceCache || (MessageObject.getMedia(message).ttl_seconds != 0 && !desu.inugram.InuConfig.SAVE_SELF_DESTRUCT.getValue()), useFileDatabaseQueue);
-                        if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT.getValue() && !res.exists()) {
+                        File res = getPathToAttach(sizeFull, null, forceCache || (MessageObject.getMedia(message).ttl_seconds != 0 && !desu.inugram.InuConfig.SAVE_SELF_DESTRUCT_MEDIA.getValue()), useFileDatabaseQueue);
+                        if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT_MEDIA.getValue() && !res.exists()) {
                             File cacheRes = getPathToAttach(sizeFull, null, true, useFileDatabaseQueue);
                             if (cacheRes.exists()) return cacheRes;
                         }
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
@@ -9954,7 +9954,7 @@ public class MessageObject {
     }
 
     public boolean needDrawBluredPreview() {
-        if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT.getValue() && isSecretMedia()) return false;
+        if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT_MEDIA.getValue() && isSecretMedia()) return false;
         if (isRepostPreview) {
             return false;
         }
@@ -11567,7 +11567,7 @@ public class MessageObject {
     }
 
     public boolean canForwardMessage() {
-        if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT.getValue() && isSecretMedia()) return true;
+        if (desu.inugram.InuConfig.SAVE_SELF_DESTRUCT_MEDIA.getValue() && isSecretMedia()) return true;
         if (isQuickReply() || isEphemeral()) return false;
         if (type == TYPE_GIFT_STARS || type == TYPE_GIFT_THEME_UPDATE || type == TYPE_SUGGEST_BIRTHDAY || type == TYPE_GIFT_OFFER || type == TYPE_SHARING_OFFER || type == TYPE_COMMUNITY_CHANGED) return false;
         return !(messageOwner instanceof TLRPC.TL_message_secret) && !needDrawBluredPreview() && !isLiveLocation() && type != MessageObject.TYPE_PHONE_CALL && !isSponsored() && (!messageOwner.noforwards || desu.inugram.InuConfig.ALLOW_FORWARD_RESTRICTED.getValue());
