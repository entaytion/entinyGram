+    // Builds the centered-square CropState directly instead of going through the interactive
+    // crop editor: that path only runs applyCurrentEditMode() when sendPhotoType == AVATAR (see
+    // sendPressed's outer guard below), so for a plain gallery video the UI crop transform is
+    // never actually applied. Deriving the crop from originalWidth/originalHeight here sidesteps
+    // that entirely.
+    private void inu_sendAsRoundVideoPressed() {
+        if (!isCurrentVideo || isCaptionOpen()) {
+            return;
+        }
+        inu_sendAsRoundVideo = true;
+        // switchToEditMode(EDIT_MODE_CROP) is never entered for this flow, and that's the only
+        // place startTime/endTime/estimatedDuration normally get recomputed - reset them here so
+        // they reflect the full, untrimmed length of the video actually being sent instead of
+        // whatever was left over from a previous edit in this long-lived PhotoViewer instance.
+        videoCutStart = 0f;
+        videoCutEnd = 1f;
+        startTime = -1;
+        endTime = -1;
+        estimatedDuration = (long) videoDuration;
+        sendPressed(true, 0, 0);
+    }
+
+    private MediaController.CropState inu_buildRoundCropState() {
+        MediaController.CropState crop = new MediaController.CropState();
+        crop.cropPx = 0f;
+        crop.cropPy = 0f;
+        crop.cropScale = 1f;
+        crop.cropRotate = 0f;
+        if (originalWidth > originalHeight) {
+            crop.cropPw = originalHeight / (float) originalWidth;
+            crop.cropPh = 1f;
+        } else if (originalHeight > originalWidth) {
+            crop.cropPw = 1f;
+            crop.cropPh = originalWidth / (float) originalHeight;
+        } else {
+            crop.cropPw = crop.cropPh = 1f;
+        }
+        crop.transformWidth = 360;
+        crop.transformHeight = 360;
+        crop.transformRotation = 0;
+        crop.mirrored = false;
+        crop.freeform = false;
+        crop.lockedAspectRatio = 1f;
+        crop.initied = true;
+        return crop;
+    }
+
