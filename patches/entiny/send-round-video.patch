+    // Opens the real crop editor (aspect locked to 1:1) so CropView computes a proper centered
+    // square crop from its actual layout/matrix state, then auto-confirms and sends - avoids
+    // hand-deriving CropState's transform math, which depends on live view measurements.
+    private void inu_sendAsRoundVideoPressed() {
+        if (!isCurrentVideo || isCaptionOpen()) {
+            return;
+        }
+        createCropView();
+        if (photoCropView == null) {
+            return;
+        }
+        photoCropView.setFreeform(false);
+        photoCropView.setAspectRatio(1.0f);
+        switchToEditMode(EDIT_MODE_CROP);
+        containerView.postDelayed(() -> {
+            inu_sendAsRoundVideo = true;
+            sendPressed(true, 0, 0);
+        }, 300);
+    }
+
     private void sendPressed(boolean notify, int scheduleDate, int scheduleRepeatPeriod, boolean replace, boolean forceDocument, boolean confirmed) {
         if (isCaptionOpen()) {
             return;
