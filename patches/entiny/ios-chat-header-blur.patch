+    public void inu_setupTopBlur(GlassEngine engine, GlassSourceRenderNode source) {
+        inu_topBlurSource = source;
+        inu_topBlur = new GlassFadeBlurredDrawable(source) {
+            private boolean waitingForSource;
+
+            @Override
+            public void getBoundsWithPaddingInset(@NonNull Rect rect) {
+                if (!inu_canCaptureTopBlur()) {
+                    waitingForSource = false;
+                    rect.setEmpty();
+                } else if (waitingForSource && !source.isDownsampledSourceSupported()) {
+                    rect.setEmpty();
+                } else {
+                    super.getBoundsWithPaddingInset(rect);
+                }
+            }
+
+            @Override
+            protected void onBoundsChange(@NonNull Rect bounds) {
+                super.onBoundsChange(bounds);
+                waitingForSource = false;
+            }
+
+            @Override
+            public void buildDisplayList() {
+                if (!source.isDownsampledSourceSupported()) {
+                    waitingForSource = true;
+                    ChatActivityFadeView.this.invalidate();
+                    return;
+                }
+                waitingForSource = false;
+                super.buildDisplayList();
+                if (!inu_drewTopBlur && hasDisplayList()) ChatActivityFadeView.this.invalidate();
+            }
+        };
+        inu_topBlur.setMaskRange(new GlassFadeRangeParams(dp(44), GlassFadeRangeParams.Gravity.START, 0, 0));
+        engine.registerDrawable(this, inu_topBlur);
+        checkBounds();
+    }
+
+    private boolean inu_canCaptureTopBlur() {
