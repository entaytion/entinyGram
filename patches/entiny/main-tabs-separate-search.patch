+    private void repositionSearchButton() {
+        if (tabsView == null || tabsViewWrapper == null || tabsBarContainer == null) return;
+        final ViewGroup.LayoutParams baseTabsLp = tabsView.getLayoutParams();
+        if (!(baseTabsLp instanceof LinearLayout.LayoutParams)) return;
+        final LinearLayout.LayoutParams tabsLp = (LinearLayout.LayoutParams) baseTabsLp;
+        final int wrapperWidth = tabsViewWrapper.getWidth() - tabsViewWrapper.getPaddingLeft() - tabsViewWrapper.getPaddingRight();
+        if (wrapperWidth <= 0) return;
+        final boolean showSearch = searchTabContainer != null && searchTabContainer.getVisibility() != View.GONE;
+        final int searchWidth = showSearch ? searchTabContainer.getLayoutParams().width : 0;
+        final int searchStartMargin = showSearch ? -dp(10) : 0;
+        final int searchEndMargin = showSearch ? dp(4) : 0;
+        final int containerPadding = tabsBarContainer.getPaddingLeft() + tabsBarContainer.getPaddingRight();
+        final int outerInset = dp(Math.min(DialogsActivity.MAIN_TABS_MARGIN, 6));
+        final int availableWidth = Math.max(0, wrapperWidth - containerPadding - searchWidth - searchStartMargin - searchEndMargin - outerInset * 2);
+        final int tabsWidth = Math.min(dp(MainTabsHelper.getTabsViewWidth()), availableWidth);
+        if (tabsLp.width != tabsWidth) {
+            tabsLp.width = tabsWidth;
+            tabsView.setLayoutParams(tabsLp);
+        }
+        if (showSearch) {
+            final int backgroundPadding = dp(MainTabsHelper.getMainTabsMargin() - 0.334f);
+            final int leftVisualPadding = tabsBarContainer.getPaddingLeft() + backgroundPadding;
+            final int rightVisualPadding = tabsBarContainer.getPaddingRight() + searchEndMargin;
+            tabsBarContainer.setTranslationX((rightVisualPadding - leftVisualPadding) / 2f);
+        } else {
+            tabsBarContainer.setTranslationX(0f);
+        }
     }
 
