From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Tue, 1 Sep 2026 11:12:44 +0300
Subject: Configure ABI filters, R8 rules, and local builds

---
 TMessagesProj/build.gradle       | 11 +++++++++--
 TMessagesProj/proguard-rules.pro | 14 +++++++++++---
 TMessagesProj_App/build.gradle   | 29 +++++++++++++++++++++++++----
 build.gradle                     | 29 +++++++++++++++++++++++++++--
 4 files changed, 72 insertions(+), 11 deletions(-)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -60,7 +60,9 @@ dependencies {
     implementation 'com.google.android.gms:play-services-location:21.0.1'
     implementation 'com.google.android.gms:play-services-wallet:19.1.0'
     implementation 'com.googlecode.mp4parser:isoparser:1.0.6'
-    implementation 'com.stripe:stripe-android:11.3.0'
+    implementation('com.stripe:stripe-android:11.3.0') {
+        exclude group: 'org.bouncycastle'
+    }
     implementation 'com.google.mlkit:language-id:17.0.6'
     implementation 'com.android.billingclient:billing:8.0.0'
     implementation 'com.google.code.gson:gson:2.11.0'
@@ -140,7 +142,12 @@ android {
         targetSdkVersion 36
 
         ndk {
-            abiFilters "arm64-v8a"
+            def filters = System.getenv('ABI_FILTERS')
+            if (filters == null || filters.isEmpty()) {
+                abiFilters "arm64-v8a"
+            } else if (filters != 'all') {
+                abiFilters filters.split(',') as String[]
+            }
         }
 
         externalNativeBuild {
diff --git a/TMessagesProj/proguard-rules.pro b/TMessagesProj/proguard-rules.pro
index 0000000..0000000 100644
--- a/TMessagesProj/proguard-rules.pro
+++ b/TMessagesProj/proguard-rules.pro
@@ -1,8 +1,13 @@
--keep public class com.google.android.gms.* { public *; }
+# Google Play Services: keep only annotated classes (KeepName) instead of wildcard keeping all gms classes
 -keepnames @com.google.android.gms.common.annotation.KeepName class *
 -keepclassmembernames class * {
     @com.google.android.gms.common.annotation.KeepName *;
 }
+
+# NagramX R8 UI allowshrinking rules
+-keepclassmembernames,allowshrinking class org.telegram.ui.* { <fields>; }
+-keepclassmembernames,allowshrinking class org.telegram.ui.Cells.* { <fields>; }
+-keepclassmembernames,allowshrinking class org.telegram.ui.Components.* { <fields>; }
 -keep class org.webrtc.* { *; }
 -keep class org.webrtc.audio.* { *; }
 -keep class org.webrtc.voiceengine.* { *; }
@@ -10,7 +15,6 @@
 -keep class org.telegram.messenger.camera.* { *; }
 -keep class org.telegram.messenger.secretmedia.* { *; }
 -keep class org.telegram.messenger.support.* { *; }
--keep class org.telegram.messenger.support.* { *; }
 -keep class org.telegram.messenger.time.* { *; }
 -keep class org.telegram.messenger.video.* { *; }
 -keep class org.telegram.messenger.voip.* { *; }
@@ -119,6 +123,10 @@
 -dontwarn javax.naming.**
 -dontwarn org.bouncycastle.cert.**
 -dontwarn org.bouncycastle.openssl.**
+# inu: lite (-PNOMAPS) builds drop maplibre, which used to transitively pull in
+# enough of org.bouncycastle to satisfy R8 for com.nimbusds's optional JWK/X.509
+# code paths (unused at runtime here). Silence R8 instead of depending on that.
+-dontwarn org.bouncycastle.**
 -dontwarn org.objectweb.asm.**
 -dontwarn com.google.crypto.tink.**
 -keep class desu.inugram.** { *; }
@@ -126,4 +134,4 @@
 
 # Use -keep to explicitly keep any other classes shrinking would remove
 -dontoptimize
--dontobfuscate
\ No newline at end of file
+-dontobfuscate
diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -24,15 +24,31 @@ dependencies {
 android {
     compileSdkVersion 36
     buildToolsVersion '36.0.0'
+    ndkVersion "27.2.12479018"
 
     defaultConfig.applicationId = "ua.entaytion.entinygram"
 
