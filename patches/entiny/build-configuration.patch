+        resources {
+            excludes += [
+                'META-INF/*.kotlin_module',
+                'META-INF/*.version',
+                'META-INF/DEPENDENCIES',
+                'META-INF/LICENSE*',
+                'META-INF/NOTICE*',
+                'META-INF/AL2.0',
+                'META-INF/LGPL2.1'
+            ]
+        }
     }
 
     lintOptions {
@@ -73,10 +89,10 @@ android {
             jniDebuggable false
             signingConfig signingConfigs.release
             minifyEnabled true
-            shrinkResources false
+            shrinkResources true
             multiDexEnabled true
             proguardFiles getDefaultProguardFile('proguard-android.txt'), '../TMessagesProj/proguard-rules.pro'
-            ndk.debugSymbolLevel = 'FULL'
+            ndk.debugSymbolLevel = 'SYMBOL_TABLE'
         }
     }
 
@@ -103,7 +119,12 @@ android {
         ndkVersion "27.2.12479018"
 
         ndk {
-            abiFilters "arm64-v8a"
+            def filters = System.getenv('ABI_FILTERS')
+            if (filters == null || filters.isEmpty()) {
+                abiFilters "arm64-v8a"
+            } else if (filters != 'all') {
+                abiFilters filters.split(',') as String[]
+            }
         }
 
         externalNativeBuild {
diff --git a/build.gradle b/build.gradle
index 0000000..0000000 100644
--- a/build.gradle
+++ b/build.gradle
@@ -35,11 +35,36 @@ subprojects {
     }
 }
 
-def commitId = System.getenv('COMMIT_ID')
+def getGitCommitSha = {
+    try {
+        def process = ['git', 'rev-parse', '--short', 'HEAD'].execute(null, rootDir)
+        process.waitFor()
+        if (process.exitValue() == 0) return process.text.trim()
+    } catch (Exception ignored) {}
+    return null
+}
+
+def getNextLocalBuildNumber = {
+    def file = new File(rootDir, '.local_build_number')
+    int current = 1000000
+    if (file.exists()) {
+        try {
+            current = file.text.trim().toInteger()
+        } catch (Exception ignored) {}
+    }
+    int next = current + 1
+    try {
+        file.text = next.toString()
+    } catch (Exception ignored) {}
+    return current
+}
+
+def commitId = System.getenv('COMMIT_ID') ?: getGitCommitSha()
+def currentVerCode = System.getenv('INU_BUILD') ? Integer.parseInt(System.getenv('INU_BUILD')) : getNextLocalBuildNumber()
 
 ext {
   verName = "${APP_VERSION_NAME}${commitId != null ? "-${commitId.take(7)}" : ''}"
-  verCode = Integer.parseInt(System.getenv('INU_BUILD') ?: '1000000')
+  verCode = currentVerCode
   stockVerCode = Integer.parseInt(APP_VERSION_CODE)
   buildDate = java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ISO_DATE)
   ccachePath = ['sh', '-c', 'command -v ccache'].execute().text.trim() ?: null
