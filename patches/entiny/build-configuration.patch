-    private Template buildNotificationsTemplate() {
-        Map<Long, ArrayList<MessageObject>> grouped = collectUnreadDuringDrive();
-        if (grouped.isEmpty()) {
-            return new MessageTemplate.Builder(LocaleController.getString(R.string.NoNewCarMessages))
-                    .build();
