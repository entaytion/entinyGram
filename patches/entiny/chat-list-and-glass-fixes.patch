+    public void inu_toggleSelectAll() {
+        if (listAdapter == null || searchIsVisible || topicsGridView.getVisibility() != View.GONE) return;
+        final MessagesController controller = MessagesController.getInstance(currentAccount);
+        final ArrayList<TLRPC.Dialog> selectable = new ArrayList<>();
+        for (TLRPC.Dialog dialog : listAdapter.dialogs) {
+            if (dialog == null || dialog instanceof ShareDialogsAdapter.MyStoryDialog) continue;
+            final TLRPC.Chat chat = controller.getChat(-dialog.id);
+            if (DialogObject.isChatDialog(dialog.id) && (chat == null || ChatObject.isForum(chat) || ChatObject.isMonoForum(chat) || ChatObject.isChannel(chat) && !chat.megagroup && (!ChatObject.isCanWriteToChannel(-dialog.id, currentAccount) || hasPoll == 2 || hasPoll == 3))) continue;
+            if (DialogObject.isEncryptedDialog(dialog.id) && hasPoll != 0) continue;
+            if (DialogObject.isUserDialog(dialog.id) && (isBotForumWithNotEmptyTopics(controller.getUser(dialog.id)) || DialogObject.isPremiumBlocked(controller.isUserContactBlocked(dialog.id)) || DialogObject.getMessagesStarsPrice(controller.isUserContactBlocked(dialog.id)) > 0)) continue;
+            if (controller.getSendPaidMessagesStars(dialog.id) > 0) continue;
+            selectable.add(dialog);
+        }
+        boolean allSelected = !selectable.isEmpty();
+        for (TLRPC.Dialog dialog : selectable) {
+            if (selectedDialogs.indexOfKey(dialog.id) < 0) {
+                allSelected = false;
+                break;
+            }
+        }
+        for (TLRPC.Dialog dialog : selectable) {
+            if (allSelected) {
+                selectedDialogs.remove(dialog.id);
+                selectedDialogTopics.remove(dialog);
+            } else if (selectedDialogs.indexOfKey(dialog.id) < 0) {
+                selectedDialogs.put(dialog.id, dialog);
+            }
+        }
+        listAdapter.notifyDataSetChanged();
+        updateSelectedCount(1);
+    }
+
