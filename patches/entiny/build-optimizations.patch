From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Thu, 6 Aug 2026 01:20:14 +0300
Subject: Optimize release build resources and proguard keep rules

---
 .gitignore                       |  3 ++-
 TMessagesProj/build.gradle       |  4 +++-
 TMessagesProj/proguard-rules.pro |  7 ++++++-
 TMessagesProj_App/.gitignore     |  3 ++-
 TMessagesProj_App/build.gradle   | 20 ++++++++++++++++++--
 5 files changed, 31 insertions(+), 6 deletions(-)

diff --git a/.gitignore b/.gitignore
index 0000000..0000000 100644
--- a/.gitignore
+++ b/.gitignore
@@ -4,7 +4,8 @@ build/
 obj/
 *.iml
 local.properties
-TMessagesProj/.cxx/
+.cxx/
+**/.cxx/
 TMessagesProj/jniLibs/
 TMessagesProj/jniRes/
 **/.DS_Store
diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -47,7 +47,9 @@ dependencies {
     implementation 'com.google.android.gms:play-services-location:21.0.1'
     implementation 'com.google.android.gms:play-services-wallet:19.1.0'
     implementation 'com.googlecode.mp4parser:isoparser:1.0.6'
-    implementation 'com.stripe:stripe-android:11.3.0'
+    implementation('com.stripe:stripe-android:11.3.0') {
+        exclude group: 'org.bouncycastle'
+    }
     implementation 'com.google.mlkit:language-id:17.0.6'
     implementation 'com.android.billingclient:billing:7.1.1'
     implementation 'com.google.code.gson:gson:2.11.0'
diff --git a/TMessagesProj/proguard-rules.pro b/TMessagesProj/proguard-rules.pro
index 0000000..0000000 100644
--- a/TMessagesProj/proguard-rules.pro
+++ b/TMessagesProj/proguard-rules.pro
@@ -1,8 +1,13 @@
--keep public class com.google.android.gms.* { public *; }
+# Google Play Services: keep only annotated classes (KeepName) instead of wildcard keeping all gms classes
 -keepnames @com.google.android.gms.common.annotation.KeepName class *
 -keepclassmembernames class * {
     @com.google.android.gms.common.annotation.KeepName *;
 }
+
+# NagramX R8 UI allowshrinking rules
+-keepclassmembernames,allowshrinking class org.telegram.ui.* { <fields>; }
+-keepclassmembernames,allowshrinking class org.telegram.ui.Cells.* { <fields>; }
+-keepclassmembernames,allowshrinking class org.telegram.ui.Components.* { <fields>; }
 -keep class org.webrtc.* { *; }
 -keep class org.webrtc.audio.* { *; }
 -keep class org.webrtc.voiceengine.* { *; }
diff --git a/TMessagesProj_App/.gitignore b/TMessagesProj_App/.gitignore
index 0000000..0000000 100644
--- a/TMessagesProj_App/.gitignore
+++ b/TMessagesProj_App/.gitignore
@@ -1,2 +1,3 @@
 /build
-/release
\ No newline at end of file
+/release
+.cxx
\ No newline at end of file
diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -24,15 +24,31 @@ dependencies {
 android {
     compileSdkVersion 35
     buildToolsVersion '35.0.0'
+    ndkVersion "27.2.12479018"
 
     defaultConfig.applicationId = "desu.inugram"
 
-    sourceSets.main.jniLibs.srcDirs = ['../TMessagesProj/jni/']
+    externalNativeBuild {
+        cmake {
+            path '../TMessagesProj/jni/CMakeLists.txt'
+        }
+    }
 
     packaging {
         jniLibs {
             useLegacyPackaging = true
         }
+        resources {
+            excludes += [
+                'META-INF/*.kotlin_module',
+                'META-INF/*.version',
+                'META-INF/DEPENDENCIES',
+                'META-INF/LICENSE*',
+                'META-INF/NOTICE*',
+                'META-INF/AL2.0',
+                'META-INF/LGPL2.1'
+            ]
+        }
     }
 
     lintOptions {
@@ -86,7 +102,7 @@ android {
             shrinkResources false
             multiDexEnabled true
             proguardFiles getDefaultProguardFile('proguard-android.txt'), '../TMessagesProj/proguard-rules.pro'
-            ndk.debugSymbolLevel = 'FULL'
+            ndk.debugSymbolLevel = 'SYMBOL_TABLE'
         }
     }
 
