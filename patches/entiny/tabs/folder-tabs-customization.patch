From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Mon, 26 Oct 2026 00:01:13 +0200
Subject: Add folder tab customization: indicator stroke, bottom placement, hide archive from chat list

---
 .../org/telegram/messenger/MessagesController.java    |  3 +++
 .../org/telegram/ui/Components/FilterTabsView.java    | 11 +++++++++--
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -9843,6 +9843,9 @@ public class MessagesController extends BaseController implements NotificationCe
         if (dialogs == null) {
             return new ArrayList<>();
         }
+        if (desu.inugram.InuConfig.HIDE_ARCHIVE_FROM_CHAT_LIST.getValue() && folderId != 1) {
+            removeFolder(1);
+        }
         return dialogs;
     }
 
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java
@@ -134,7 +134,7 @@ public class FilterTabsView extends FrameLayout {
             int width = titleWidth = FolderHelper.getContentWidth(title, textPaint);
             int c;
             if (store) {
-                c = delegate.getTabCounter(id);
+                c = desu.inugram.InuConfig.FOLDERS_UNREAD_COUNTER_MODE.getValue() == desu.inugram.InuConfig.FoldersUnreadCounterModeItem.HIDE ? 0 : delegate.getTabCounter(id);
                 if (c < 0) {
                     c = 0;
                 }
@@ -1535,6 +1535,13 @@ public class FilterTabsView extends FrameLayout {
                 counterVisible = tabView.tabCounterVisible;
             }
         }
+        if (desu.inugram.InuConfig.TAB_INDICATOR_STROKE.getValue()) {
+            selectorDrawable.setStroke(AndroidUtilities.dp(1), Theme.getColor(activeTextColorKey, resourcesProvider));
+            selectorDrawable.setColor(ColorUtils.setAlphaComponent(Theme.getColor(tabLineColorKey), 50));
+        } else {
+            selectorDrawable.setStroke(0, 0);
+            selectorDrawable.setColor(Theme.getColor(tabLineColorKey, resourcesProvider));
+        }
         if (indicatorWidth != 0) {
             canvas.save();
             canvas.translate(listView.getTranslationX(), 0);
@@ -1547,7 +1554,7 @@ public class FilterTabsView extends FrameLayout {
             } else {
                 final int y = height / 2 - dp(14);
                 selectorDrawable.setBounds((int) (indicatorX - dp(FolderHelper.getTabInternalPadding()) - add), y, (int) (indicatorX + indicatorWidth + dp(FolderHelper.getTabInternalPadding()) + add), y + dp(28));
-                selectorDrawable.setAlpha(31);
+                if (!desu.inugram.InuConfig.TAB_INDICATOR_STROKE.getValue()) selectorDrawable.setAlpha(31);
             }
             selectorDrawable.draw(canvas);
             canvas.restore();
