From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Tue, 15 Sep 2026 19:11:26 +0300
Subject: entiny(dialogs): add a Recent Chats quick-switcher

- track the most recently opened dialogs (own inu_recent_dialogs table)
  via a hook in ChatActivity view creation
- popup listing them (avatar, title, tap to open, long-press for
  profile) reachable from the dialogs-screen options menu, with a
  clear-history action - inspired by exteraless/NekoGram BackButtonMenuRecent
---
 .../java/org/telegram/messenger/MediaDataController.java   | 2 +-
 .../src/main/java/org/telegram/ui/ChatActivity.java        | 5 +++++
 .../src/main/java/org/telegram/ui/DialogsActivity.java     | 7 ++++++-
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java
@@ -5011,7 +5011,7 @@ public class MediaDataController extends BaseController {
             maxShortcuts = 5;
         }
         ArrayList<TLRPC.TL_topPeer> hintsFinal = new ArrayList<>();
-        if (SharedConfig.passcodeHash.length() <= 0) {
+        if (SharedConfig.passcodeHash.length() <= 0 && !desu.inugram.InuConfig.HIDE_RECENT_CHATS_SHORTCUTS.getValue()) {
             for (int a = 0; a < hints.size(); a++) {
                 hintsFinal.add(hints.get(a));
                 if (hintsFinal.size() == maxShortcuts - 2) {
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -9068,6 +9068,10 @@ public class ChatActivity extends BaseFragment implements
             }
         }
 
+        if (currentUser != null || currentChat != null) {
+            desu.inugram.helpers.dialogs.RecentChatsHelper.addToRecentDialogs(currentAccount, currentUser != null ? currentUser.id : -currentChat.id);
+        }
+
         if (getDialogId() == getUserConfig().getClientUserId() && chatMode != MODE_SAVED) {
             savedMessagesHint = new HintView2(context, HintView2.DIRECTION_TOP);
             savedMessagesHint.setMultilineText(true);
@@ -9196,6 +9200,7 @@ public class ChatActivity extends BaseFragment implements
         ViewCompat.setOnApplyWindowInsetsListener(fragmentView, this::onApplyWindowInsets);
         Timer.finish(t);
 
+        desu.inugram.helpers.dialogs.RecentChatsSidebar.attach(this, getDialogId());
         return fragmentView;
     }
 
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
@@ -2117,12 +2117,16 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
                 additionalPadding += h;
             }
 
+            final int inu_strip = desu.inugram.helpers.dialogs.RecentChatsSidebar.stripTopPush(DialogsActivity.this);
+            t += inu_strip;
+            additionalPadding += inu_strip;
+
             if (!NonIslandHelper.foldersBar() && !FolderHelper.atBottom()) {
                 t -= dp(5 * Math.max(filterTabsVisibility, topPanelsVisibility));
                 additionalPadding -= dp(5 * Math.max(filterTabsVisibility, topPanelsVisibility));
             }
 
-            final int b = calculateListViewPaddingBottom();
+            final int b = calculateListViewPaddingBottom() + desu.inugram.helpers.dialogs.RecentChatsSidebar.stripBottomPush(DialogsActivity.this);
             if (t != topPadding || b != getPaddingBottom()) {
                 setTopGlowOffset(t);
                 setPadding(0, t, 0, b);
@@ -5777,6 +5781,7 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
         checkUi_searchFieldStyle();
 
         ViewCompat.setOnApplyWindowInsetsListener(fragmentView, this::onApplyWindowInsets);
+        if (!onlySelect && folderId == 0) desu.inugram.helpers.dialogs.RecentChatsSidebar.attach(this, 0);
         return fragmentView;
     }
 
