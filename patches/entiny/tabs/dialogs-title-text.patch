@@ -6946,6 +6952,45 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
         switchToCurrentSelectedMode(false);
     }
 
+    public MessagesController.DialogFilter inu_getCurrentFilter() {
+        if (viewPages == null || viewPages.length == 0 || viewPages[0] == null) {
+            return null;
+        }
+        ArrayList<MessagesController.DialogFilter> filters = getMessagesController().getDialogFilters();
+        int index = viewPages[0].selectedType;
+        return index >= 0 && index < filters.size() ? filters.get(index) : null;
+    }
+
+    // Settled page only: the tabs animation end, the swipe progress==1 callback, and
+    // switchToCurrentSelectedMode when nothing is in flight. Never mid-swipe -- the drag-reversal
+    // reset and the touch-interrupt path both abandon a transition without notifying us, so
+    // committing a title early would leave the target folder's name on a page the user left.
+    private void inu_updateSettledFolderTitle() {
+        MessagesController.DialogFilter filter = inu_getCurrentFilter();
+        if (filter == null) {
+            return;
+        }
+        inu_applyDialogsTitle();
+        if (dialogStoriesCell != null) {
+            dialogStoriesCell.updateItems(true, false);
+        }
+    }
+
+    private void inu_applyDialogsTitle() {
+        if (actionBar == null || communityId != 0 || desu.inugram.helpers.security.ParanoiaHelper.isDisguised()) {
+            return;
+        }
+        if (folderId != 0 && !desu.inugram.InuConfig.DIALOGS_TITLE_TEXT_OVERRIDE_ARCHIVE.getValue()) {
+            return;
+        }
+        CharSequence title = desu.inugram.helpers.chat.ChatHelper.getDialogsTitle(this, currentAccount);
+        SimpleTextView titleView = actionBar.getTitleTextView();
+        if (titleView != null && titleView.getVisibility() == View.VISIBLE && titleView.getAlpha() == 1f && !TextUtils.equals(titleView.getText(), title)) {
+            actionBar.setTitleAnimated(title, animatingForward, 220, CubicBezierInterpolator.DEFAULT);
+        }
+        actionBar.setTitle(title, statusDrawable);
+    }
+
     public void switchToCurrentSelectedMode(boolean animated) {
         for (int a = 0; a < viewPages.length; a++) {
             viewPages[a].listView.stopScroll();
@@ -6972,6 +7017,10 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
             viewPages[1].isLocked = filter.locked;
         }
 
+        if (!animated && !startedTracking && !tabsAnimationInProgress) {
+            inu_updateSettledFolderTitle();
+        }
+
         viewPages[a].dialogsAdapter.setDialogsType(viewPages[a].dialogsType);
         viewPages[a].layoutManager.scrollToPositionWithOffset(viewPages[a].dialogsType == DIALOGS_TYPE_DEFAULT && hasHiddenArchive() && viewPages[a].archivePullViewState == ARCHIVE_ITEM_STATE_HIDDEN ? 1 : 0, (int) scrollYOffset);
         checkListLoad(viewPages[a]);
@@ -7063,6 +7112,8 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
                 FolderHelper.refreshSelectedTab(filterTabsView, viewPages[0].selectedType, filters.size());
                 if (updateCurrentTab) {
                     switchToCurrentSelectedMode(false);
+                } else {
+                    inu_applyDialogsTitle();
                 }
                 if (filterTabsView.isLocked(filterTabsView.getCurrentTabId())) {
                     filterTabsView.selectFirstTab();
