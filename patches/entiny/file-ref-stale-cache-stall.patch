+++ b/TMessagesProj/src/main/java/org/telegram/messenger/FileRefController.java
@@ -442,6 +442,7 @@ public class FileRefController extends BaseController {
         if (added != 2) {
             return;
         }
+        final ArrayList<Requester> inu_parentRequesters = arrayList;
 
         String cacheKey = locationKey;
         if (parentObject instanceof String) {
@@ -464,7 +465,8 @@ public class FileRefController extends BaseController {
         if (cachedResult != null) {
             if (!onRequestComplete(locationKey, parentKey, cachedResult.response, null,false, true)) {
                 responseCache.remove(locationKey);
-            } else {
+                inu_keepPendingRequesters(parentKey, inu_parentRequesters);
+            } else if (!inu_keepPendingRequesters(parentKey, inu_parentRequesters)) {
                 return;
             }
         } else {
@@ -472,7 +474,8 @@ public class FileRefController extends BaseController {
             if (cachedResult != null) {
                 if (!onRequestComplete(locationKey, parentKey, cachedResult.response, null, false, true)) {
                     responseCache.remove(parentKey);
-                } else {
+                    inu_keepPendingRequesters(parentKey, inu_parentRequesters);
+                } else if (!inu_keepPendingRequesters(parentKey, inu_parentRequesters)) {
                     return;
                 }
             }
@@ -480,6 +483,45 @@ public class FileRefController extends BaseController {
         requestReferenceFromServer(parentObject, locationKey, parentKey, args);
     }
 
+    // entiny: a stale cache answer leaves requesters waiting, so they must stay reachable by the server answer
+    private boolean inu_keepPendingRequesters(String parentKey, ArrayList<Requester> requesters) {
+        requesters.removeIf(requester -> requester.completed);
+        if (requesters.isEmpty()) {
+            return false;
+        }
+        parentRequester.put(parentKey, requesters);
+        return true;
+    }
+
+    // entiny: a parent with no refresh request left its requesters mapped, so the next request for that file never got an answer
+    private void inu_failWithoutRequest(String locationKey, String parentKey, Object[] args) {
+        ArrayList<Requester> waiting = new ArrayList<>();
+        ArrayList<Requester> byLocation = locationRequester.remove(locationKey);
+        if (byLocation != null) {
+            waiting.addAll(byLocation);
+        }
+        ArrayList<Requester> byParent = parentRequester.remove(parentKey);
+        if (byParent != null) {
+            for (Requester requester : byParent) {
+                if (!waiting.contains(requester)) {
+                    waiting.add(requester);
+                }
+            }
+        }
+        boolean failedArgs = false;
+        for (Requester requester : waiting) {
+            if (requester.completed) {
+                continue;
+            }
+            requester.completed = true;
+            failedArgs |= requester.args == args;
+            sendErrorToObject(requester.args, 0);
+        }
+        if (!failedArgs) {
+            sendErrorToObject(args, 0);
+        }
+    }
+
     private String getObjectString(Object parentObject) {
         if (parentObject instanceof String) {
             return (String) parentObject;
@@ -510,7 +552,7 @@ public class FileRefController extends BaseController {
         if (parentObject instanceof StoriesController.BotPreview) {
             StoriesController.BotPreview storyItem = (StoriesController.BotPreview) parentObject;
             if (storyItem.list == null) {
-                sendErrorToObject(args, 0);
+                inu_failWithoutRequest(locationKey, parentKey, args);
                 return;
             }
             storyItem.list.requestReference(storyItem, newStoryItem -> {
@@ -690,10 +732,10 @@ public class FileRefController extends BaseController {
                         getConnectionsManager().sendRequest(req, (response, error) -> onRequestComplete(locationKey, parentKey, response, error, false, false));
                     }
                 } else {
-                    sendErrorToObject(args, 0);
+                    inu_failWithoutRequest(locationKey, parentKey, args);
                 }
             } else {
-                sendErrorToObject(args, 0);
+                inu_failWithoutRequest(locationKey, parentKey, args);
             }
         } else if (parentObject instanceof TLRPC.TL_messages_stickerSet) {
             TLRPC.TL_messages_stickerSet stickerSet = (TLRPC.TL_messages_stickerSet) parentObject;
@@ -714,7 +756,7 @@ public class FileRefController extends BaseController {
             req.stickerset = (TLRPC.InputStickerSet) parentObject;
             getConnectionsManager().sendRequest(req, (response, error) -> onRequestComplete(locationKey, parentKey, response, error, true, false));
         } else {
-            sendErrorToObject(args, 0);
+            inu_failWithoutRequest(locationKey, parentKey, args);
         }
     }
 
@@ -1485,12 +1527,17 @@ public class FileRefController extends BaseController {
             if (result != null) {
                 if (onUpdateObjectReference(requester, result, locationReplacement != null ? locationReplacement[0] : null, fromCache)) {
                     found = true;
+                } else {
+                    requester.completed = false;
                 }
             } else {
                 sendErrorToObject(requester.args, 1);
             }
         }
-        locationRequester.remove(locationKey);
+        arrayList.removeIf(requester -> requester.completed);
+        if (arrayList.isEmpty()) {
+            locationRequester.remove(locationKey);
+        }
         if (found) {
             putReponseToCache(cacheKey, response);
         }
