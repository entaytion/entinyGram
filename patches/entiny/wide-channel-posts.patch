+    private int getWideChannelPostBackgroundWidth(MessageObject messageObject, boolean mediaBackground) {
+        if (messageObject == null || !messageObject.isWideChannelPost()) {
+            return 0;
+        }
+        int width = getGroupPhotosBaseWidth();
+        if (width <= 0) {
+            return 0;
+        }
