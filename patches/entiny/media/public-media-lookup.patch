diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java b/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/FileLoader.java
@@ -261,6 +261,36 @@ public class FileLoader extends BaseController {
         return mediaDirs.get(type);
     }
 
+    // entiny: media may live in the public dir while lookups use the private one
+    public static File resolveMediaFile(int type, String fileName) {
+        File dir = getDirectory(type);
+        if (dir == null || fileName == null) {
+            return new File("");
+        }
+        File res = new File(dir, fileName);
+        if (res.exists()) {
+            return res;
+        }
+        if (type != MEDIA_DIR_IMAGE && type != MEDIA_DIR_VIDEO) {
+            return res;
+        }
+        File publicDir = mediaDirs.get(type == MEDIA_DIR_IMAGE ? MEDIA_DIR_IMAGE_PUBLIC : MEDIA_DIR_VIDEO_PUBLIC);
+        if (publicDir != null) {
+            File publicRes = new File(publicDir, fileName);
+            if (publicRes.exists()) {
+                return publicRes;
+            }
+        }
+        File parent = dir.getParentFile();
+        if (parent != null) {
+            File mirrored = new File(new File(parent, desu.inugram.InuConfig.DOWNLOAD_DIRECTORY.getValue() + (type == MEDIA_DIR_IMAGE ? " Images" : " Video")), fileName);
+            if (mirrored.exists()) {
+                return mirrored;
+            }
+        }
+        return res;
+    }
+
     public static File getDirectory(int type) {
         File dir = mediaDirs.get(type);
         if (dir == null && type != FileLoader.MEDIA_DIR_CACHE) {
@@ -778,9 +808,15 @@ public class FileLoader extends BaseController {
         f = new File(getDirectory(MEDIA_DIR_IMAGE), fileName);
         if (f.exists()) return f;
 
+        f = new File(getDirectory(MEDIA_DIR_IMAGE_PUBLIC), fileName);
+        if (f.exists()) return f;
+
         f = new File(getDirectory(MEDIA_DIR_VIDEO), fileName);
         if (f.exists()) return f;
 
+        f = new File(getDirectory(MEDIA_DIR_VIDEO_PUBLIC), fileName);
+        if (f.exists()) return f;
+
         f = new File(getDirectory(MEDIA_DIR_FILES), fileName);
         if (f.exists()) return f;
 
@@ -972,6 +1008,16 @@ public class FileLoader extends BaseController {
                         }
                     }
 
+                    // entiny: only follow an existing file outside the default dir, otherwise public save would be skipped
+                    if (!saveCustomPath) {
+                        File existing = resolveMediaFile(type, fileName);
+                        File defaultDir = getDirectory(type);
+                        if (existing.exists() && defaultDir != null && !defaultDir.equals(existing.getParentFile())) {
+                            storeFileName = existing.getName();
+                            storeDir = existing.getParentFile();
+                        }
+                    }
+
                     if (saveCustomPath) {
                         operation.pathSaveData = new FilePathDatabase.PathData(documentId, dcId, type);
                     }
@@ -1450,7 +1496,8 @@ public class FileLoader extends BaseController {
                 return new File(path);
             }
         }
-        return new File(dir, getAttachFileName(attach, ext));
+        String attachFileName = getAttachFileName(attach, ext);
+        return dir.equals(getDirectory(type)) ? resolveMediaFile(type, attachFileName) : new File(dir, attachFileName);
     }
 
     public FilePathDatabase getFileDatabase() {
