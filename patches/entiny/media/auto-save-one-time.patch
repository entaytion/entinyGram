@@ -15911,7 +15911,12 @@ public class ChatActivity extends BaseFragment implements
             msgs.add(messageObject);
             updateMessages(msgs, true);
         }
-        return () -> getMessagesController().doDeleteShowOnceTask(taskId, dialog_id, messageObject.getId());
+        return () -> {
+            if (desu.inugram.InuConfig.AUTO_SAVE_ONE_TIME.getValue() && desu.inugram.helpers.security.SelfDestructHelper.shouldPreserveMedia(dialog_id)) {
