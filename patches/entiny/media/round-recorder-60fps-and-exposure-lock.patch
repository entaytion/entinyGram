+    // Per-session, not a global/static flag: in dual-camera mode two Camera2Session instances
+    // (front + back) negotiate FPS almost concurrently on session open, and a single shared
+    // field would let whichever one finishes last silently overwrite the other's result --
+    // mismatching the encoder's declared frame rate against the camera that's actually feeding
+    // it, which corrupts timestamps and breaks send. Keeping it here makes that race impossible.
+    private int negotiatedFps = 30;
+    public int getNegotiatedFps() {
+        return negotiatedFps;
+    }
+
+    private boolean aeLocked = desu.inugram.InuConfig.ROUND_RECORDER_LOCK_EXPOSURE.getValue();
+    public void setAeLocked(boolean locked) {
+        if (aeLocked != locked) {
+            aeLocked = locked;
+            updateCaptureRequest();
+        }
+    }
+    public boolean isAeLocked() {
+        return aeLocked;
+    }
+
+    // entiny: raw device compensation steps, converted to/from human EV via getExposureCompensationStep()
+    private int exposureCompensation = 0;
+    public boolean isFrontCamera() {
+        return isFront;
+    }
+    public float getExposureCompensationStep() {
+        Rational step = cameraCharacteristics != null ? cameraCharacteristics.get(CameraCharacteristics.CONTROL_AE_COMPENSATION_STEP) : null;
+        return step != null && step.floatValue() > 0f ? step.floatValue() : 1f;
+    }
+    public Range<Integer> getExposureCompensationRange() {
+        return cameraCharacteristics != null ? cameraCharacteristics.get(CameraCharacteristics.CONTROL_AE_COMPENSATION_RANGE) : null;
+    }
+    public float getExposureCompensationEv() {
+        return exposureCompensation * getExposureCompensationStep();
+    }
+    public void setExposureCompensationEv(float ev) {
+        Range<Integer> range = getExposureCompensationRange();
+        int raw = Math.round(ev / getExposureCompensationStep());
+        if (range != null) raw = Math.max(range.getLower(), Math.min(range.getUpper(), raw));
+        if (exposureCompensation != raw) {
+            exposureCompensation = raw;
+            updateCaptureRequest();
+        }
+    }
+
     private void updateCaptureRequest() {
         if (cameraDevice == null || surface == null || captureSession == null) return;
         try {
