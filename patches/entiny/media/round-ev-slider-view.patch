From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xmogdemaybe <xmogdelegenda@gmail.com>
Date: Thu, 5 Nov 2026 11:12:21 +0400
Subject: Add round recorder exposure slider type to SliderView

---
 .../ui/Stories/recorder/SliderView.java       | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Stories/recorder/SliderView.java b/TMessagesProj/src/main/java/org/telegram/ui/Stories/recorder/SliderView.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Stories/recorder/SliderView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Stories/recorder/SliderView.java
@@ -20,6 +20,7 @@ import android.view.View;
 import android.view.ViewConfiguration;
 
 import androidx.annotation.NonNull;
+import androidx.core.graphics.ColorUtils;
 
 import org.telegram.messenger.AndroidUtilities;
 import org.telegram.messenger.LocaleController;
@@ -90,6 +91,10 @@ public class SliderView extends View {
                 text2.setText(LocaleController.getString(R.string.FlashIntensity));
             } else if (currentType == TYPE_DIMMING) {
                 text2.setText(LocaleController.getString(R.string.WallpaperDimming));
+            } else if (currentType == TYPE_EXPOSURE_CG) {
+                // entiny: компактный формат 200x30 под слайдер экспозиции round-рекордера (порт CherryGram)
+                text2.setTextSize(dp(12));
+                text2.setText(LocaleController.getString(R.string.InuRoundExposure));
             }
         }
         text.setText("");
@@ -242,6 +247,8 @@ public class SliderView extends View {
 //            text.setTextColor(warmthColor);
 //            text2.setTextColor(warmthColor);
             whitePaint.setColor(warmthColor);
+        } else if (currentType == TYPE_EXPOSURE_CG) {
+            whitePaint.setColor(getColorForExposure(value));
         }
         invalidate();
     }
@@ -264,6 +271,9 @@ public class SliderView extends View {
             // TODO: fix this nonsense
             w = (int) Math.min(textPaint.measureText(LocaleController.getString(R.string.StoryAudioRemove)) + dp(88), MeasureSpec.getSize(widthMeasureSpec));
             h = dp(48);
+        } else if (currentType == TYPE_EXPOSURE_CG) {
+            w = dp(200);
+            h = dp(30);
         } else {
             w = dp(190);
             h = dp(44);
@@ -305,4 +315,14 @@ public class SliderView extends View {
     protected boolean verifyDrawable(@NonNull Drawable who) {
         return who == text || who == text2 || super.verifyDrawable(who);
     }
+
+    // entiny: тип для слайдера экспозиции round-рекордера, порт CherryGram (@arsLan4k1390)
+    public static final int TYPE_EXPOSURE_CG = 10;
+
+    public static int getColorForExposure(float warmth) {
+        if (warmth < .5f) {
+            return ColorUtils.blendARGB(0xFF303030, 0xFF999999, Utilities.clamp(warmth / .5f, 1, 0));
+        }
+        return ColorUtils.blendARGB(0xFF999999, 0xffffffff, Utilities.clamp((warmth - .5f) / .5f, 1, 0));
+    }
 }
