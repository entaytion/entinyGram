             desu.inugram.helpers.security.GhostHelper.allowReadContents(messageObject.getId());
         }
@@ -16116,7 +16119,7 @@ public class ChatActivity extends BaseFragment implements
             return null;
         }
         if (desu.inugram.helpers.security.SelfDestructHelper.shouldPreserveMedia(dialog_id)) {
-            return null;
+            return desu.inugram.InuConfig.AUTO_SAVE_ONE_TIME.getValue() ? () -> desu.inugram.helpers.chat.ChatHelper.autoSaveOneTime(this, messageObject) : null;
         }
         final long taskId = getMessagesController().createDeleteShowOnceTask(dialog_id, messageObject.getId());
         messageObject.forceExpired = true;
