+    private void applyExposure(@NonNull CaptureRequest.Builder builder) {
+        if (characteristics == null) return;
+        Rational step = characteristics.get(CameraCharacteristics.CONTROL_AE_COMPENSATION_STEP);
+        Range<Integer> range = characteristics.get(CameraCharacteristics.CONTROL_AE_COMPENSATION_RANGE);
+        if (step != null && range != null) {
+            builder.set(CaptureRequest.CONTROL_AE_EXPOSURE_COMPENSATION, ExposureEv.evToSteps(
+                    requestedExposureEv, step.getNumerator(), step.getDenominator(),
+                    range.getLower(), range.getUpper()));
+        }
+        Boolean lockAvailable = characteristics.get(CameraCharacteristics.CONTROL_AE_LOCK_AVAILABLE);
+        if (lockAvailable == null || lockAvailable) {
+            builder.set(CaptureRequest.CONTROL_AE_LOCK, aeLocked);
+        }
+    }
