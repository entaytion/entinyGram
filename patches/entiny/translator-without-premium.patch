diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/LanguageDetector.java b/TMessagesProj/src/main/java/org/telegram/messenger/LanguageDetector.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/LanguageDetector.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/LanguageDetector.java
@@ -13,13 +13,38 @@ public class LanguageDetector {
     public static boolean hasSupport() {
         // MLKit's language-id native lib crashes (SIGABRT) under ARM translation on
         // emulators; skip auto-detection there so translate doesn't break the app.
-        if (Build.FINGERPRINT != null && (Build.FINGERPRINT.contains("generic")
-                || Build.FINGERPRINT.toLowerCase().contains("emulator"))) {
+        String fp = Build.FINGERPRINT;
+        if (fp != null && (fp.contains("generic") || fp.toLowerCase().contains("emulator"))) {
             return false;
         }
-        if (Build.MODEL != null && (Build.MODEL.contains("Emulator")
-                || Build.MODEL.contains("Android SDK built for")
-                || Build.MODEL.toLowerCase().contains("google_sdk"))) {
+        String model = Build.MODEL;
+        if (model != null && (model.contains("Emulator")
+                || model.contains("Android SDK built for")
+                || model.toLowerCase().contains("google_sdk"))) {
+            return false;
+        }
+        String brand = Build.BRAND;
+        if (brand != null && brand.toLowerCase().contains("generic")) {
+            return false;
+        }
+        String device = Build.DEVICE;
+        if (device != null && device.toLowerCase().contains("generic")) {
+            return false;
+        }
+        String hardware = Build.HARDWARE;
+        if (hardware != null && (hardware.contains("goldfish") || hardware.contains("ranchu"))) {
+            return false;
+        }
+        String product = Build.PRODUCT;
+        if (product != null && (product.contains("emulator") || product.contains("google_sdk"))) {
+            return false;
+        }
+        String manufacturer = Build.MANUFACTURER;
+        if (manufacturer != null && manufacturer.toLowerCase().contains("emulator")) {
+            return false;
+        }
+        String host = Build.HOST;
+        if (host != null && host.toLowerCase().contains("emulator")) {
             return false;
         }
         return true;
