     public void markDialogMessageAsDeleted(long dialogId, ArrayList<Integer> messages) {
+        if (desu.inugram.InuConfig.SAVE_DELETED_MESSAGES.getValue()) {
+            if (messages != null) {
+                ArrayList<MessageObject> objs = dialogMessage.get(dialogId);
+                for (int a = 0; a < messages.size(); a++) {
+                    int id = messages.get(a);
+                    MessageObject found = null;
+                    if (objs != null) {
+                        for (int i = 0; i < objs.size(); ++i) {
+                            MessageObject obj = objs.get(i);
+                            if (obj != null && obj.getId() == id) {
+                                found = obj;
+                                break;
+                            }
+                        }
+                    }
+                    if (found != null) {
+                        long fromId = found.messageOwner != null && found.messageOwner.from_id != null ? org.telegram.messenger.DialogObject.getPeerDialogId(found.messageOwner.from_id) : 0;
+                        String text = found.messageOwner != null ? found.messageOwner.message : "";
+                        int date = found.messageOwner != null ? found.messageOwner.date : 0;
+                        desu.inugram.helpers.chat.SavedMessagesHelper.markMessageDeleted(currentAccount, dialogId, id, fromId, text, date);
+                    } else {
+                        desu.inugram.helpers.chat.SavedMessagesHelper.markMessageDeleted(currentAccount, dialogId, id, 0L, "", 0);
+                    }
+                }
+            }
+        }
         ArrayList<MessageObject> objs = dialogMessage.get(dialogId);
