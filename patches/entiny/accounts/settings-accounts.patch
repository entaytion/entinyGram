Subject: feat(entiny): optional accounts list on the settings screen

---
 .../src/main/java/org/telegram/ui/SettingsActivity.java    | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java
@@ -717,6 +717,13 @@ public class SettingsActivity extends BaseFragment implements NotificationCenter
 
         // inu: the accounts list is hidden entirely - switching happens from the drawer/avatar
         // (ported from inugram PR #34, made unconditional)
+        if (!accountNumbers.isEmpty() && desu.inugram.InuConfig.SETTINGS_SHOW_ACCOUNTS.getValue()) { // entiny: opt back in
+            items.add(UItem.asHeader(getString(R.string.SettingsAccounts)));
+            for (int i = 0; i < accountNumbers.size(); ++i) {
+                items.add(AccountCell.Factory.of(i, accountNumbers.get(i)));
+            }
+            items.add(UItem.asShadow(null));
+        }
 
         final int inu_reorderFrom = items.size();
         // inu: everything from here down to the version cell is one reorderable/hideable pool
