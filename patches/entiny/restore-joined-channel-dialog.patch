+                    } else {
+                        inu_loadMissingJoinedChannelDialog(chatId);
                     }
                 });
             } else {
@@ -12885,6 +12887,14 @@ public class MessagesController extends BaseController implements NotificationCe
         getNotificationsController().deleteAllNotificationChannels();
     }
 
+    private void inu_loadMissingJoinedChannelDialog(long channelId) {
+        TLRPC.Chat chat = getChat(channelId);
+        if (dialogs_dict.get(-channelId) == null && chat instanceof TLRPC.TL_channel &&
+                !chat.min && chat.access_hash != 0 && !ChatObject.isNotInChat(chat)) {
+            loadUnknownDialog(getInputPeer(-channelId), 0);
+        }
+    }
+
     protected void loadUnknownDialog(final TLRPC.InputPeer peer, long taskId) {
         if (peer == null) {
             return;
@@ -17270,6 +17280,7 @@ public class MessagesController extends BaseController implements NotificationCe
             channelPts = channelsPts.get(channelId);
             if (channelPts != 0) {
                 AndroidUtilities.runOnUIThread(() -> {
+                    inu_loadMissingJoinedChannelDialog(channelId);
                     NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.onReceivedChannelDifference, channelId);
                 });
                 return;
