+    private long getTimeoutMillis() {
+        int index = SharedConfig.proxyRotationTimeout;
+        if (index < 0 || index >= ROTATION_TIMEOUTS.size()) {
+            index = DEFAULT_TIMEOUT_INDEX;
+        }
+        return ROTATION_TIMEOUTS.get(index) * 1000L;
+    }
