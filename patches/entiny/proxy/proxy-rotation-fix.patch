+    private void scheduleTick() {
+        if (!isRotationActive()) {
+            return;
+        }
+        AndroidUtilities.cancelRunOnUIThread(rotationTickRunnable);
+        AndroidUtilities.runOnUIThread(rotationTickRunnable, getTimeoutMillis());
+    }
+
+    private void rotationTick() {
+        if (!isRotationActive() || !isConnectingToProxy()) {
+            isCurrentlyChecking = false;
+            return;
+        }
+        try {
+            if (isCurrentlyChecking) {
+                if (SystemClock.elapsedRealtime() - checkingStartedAt < Math.max(getTimeoutMillis() * 3, 15000L)) {
+                    return;
+                }
+                isCurrentlyChecking = false;
+                for (SharedConfig.ProxyInfo info : SharedConfig.proxyList) {
+                    info.checking = false;
+                }
+            }
+            if (!switchToAvailable()) {
+                startProxyChecks();
+                switchToNext();
+            }
+        } finally {
+            scheduleTick();
+        }
+    }
 
