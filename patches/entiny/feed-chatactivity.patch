+            return;
+        }
+        if (feedController.loadInitial(classGuid, lastLoadIndex++)) {
+            AndroidUtilities.cancelRunOnUIThread(loadNextNewerFeedPage);
+            AndroidUtilities.runOnUIThread(loadNextNewerFeedPage);
+        }
