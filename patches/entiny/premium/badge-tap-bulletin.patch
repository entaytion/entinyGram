From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Wed, 9 Sep 2026 16:22:18 +0300
Subject: Show an info bulletin when tapping a dev badge in a profile

---
 .../main/java/org/telegram/ui/ProfileActivity.java | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -11912,8 +11912,15 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                 if (leftIcon == null && currentEncryptedChat == null && user.bot_verification_icon != 0) {
                     nameTextView.setLeftDrawableOutside(true);
                     leftIcon = getBotVerificationDrawable(user.bot_verification_icon, false);
+                    if (desu.inugram.helpers.badges.BadgeRegistry.hasBadge(user.id)) {
+                        final long inu_userId = user.id;
+                        nameTextView.setLeftDrawableOnClick(v -> desu.inugram.helpers.badges.BadgeRegistry.showInfoBulletin(ProfileActivity.this, inu_userId));
+                    } else {
+                        nameTextView.setLeftDrawableOnClick(null);
+                    }
                 } else {
                     nameTextView.setLeftDrawableOutside(false);
+                    nameTextView.setLeftDrawableOnClick(null);
                 }
                 nameTextView.setLeftDrawable(leftIcon);
                 if (rightIconIsStatus || rightIconIsPremium) {
@@ -12186,8 +12193,15 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                 if (chat.bot_verification_icon != 0) {
                     nameTextView.setLeftDrawableOutside(true);
                     nameTextView.setLeftDrawable(getBotVerificationDrawable(chat.bot_verification_icon, false));
+                    if (desu.inugram.helpers.badges.BadgeRegistry.hasBadge(-chat.id)) {
+                        final long inu_chatId = -chat.id;
+                        nameTextView.setLeftDrawableOnClick(v -> desu.inugram.helpers.badges.BadgeRegistry.showInfoBulletin(ProfileActivity.this, inu_chatId));
+                    } else {
+                        nameTextView.setLeftDrawableOnClick(null);
+                    }
                 } else {
                     nameTextView.setLeftDrawable(null);
+                    nameTextView.setLeftDrawableOnClick(null);
                 }
                 profileStatusText = appendCommunityHiddenRow(profileStatusString);
                 photoDescriptionText = null;
