diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java b/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/camera/Camera2Session.java
@@ -486,6 +486,27 @@ public class Camera2Session {
         }
     }
 
+    // Per-session, not a global/static flag: in dual-camera mode two Camera2Session instances
+    // (front + back) negotiate FPS almost concurrently on session open, and a single shared
+    // field would let whichever one finishes last silently overwrite the other's result --
+    // mismatching the encoder's declared frame rate against the camera that's actually feeding
+    // it, which corrupts timestamps and breaks send. Keeping it here makes that race impossible.
+    private int negotiatedFps = 30;
+    public int getNegotiatedFps() {
+        return negotiatedFps;
+    }
+
+    private boolean aeLocked = desu.inugram.InuConfig.ROUND_RECORDER_LOCK_EXPOSURE.getValue();
+    public void setAeLocked(boolean locked) {
+        if (aeLocked != locked) {
+            aeLocked = locked;
+            updateCaptureRequest();
+        }
+    }
+    public boolean isAeLocked() {
+        return aeLocked;
+    }
+
     private void updateCaptureRequest() {
         if (cameraDevice == null || surface == null || captureSession == null) return;
         try {
@@ -508,11 +529,29 @@ public class Camera2Session {
             captureRequestBuilder.set(CaptureRequest.FLASH_MODE, flashing ? (recordingVideo ? CaptureRequest.FLASH_MODE_TORCH : CaptureRequest.FLASH_MODE_SINGLE) : CaptureRequest.FLASH_MODE_OFF);
 
             if (recordingVideo) {
-                // inu: capping to 30 fps to prevent a/v sync drift. more of a workaround, but it works :shrug:
-                captureRequestBuilder.set(CaptureRequest.CONTROL_AE_TARGET_FPS_RANGE, new Range<Integer>(30, 30));
+                Range<Integer> fpsRange;
+                if (desu.inugram.InuConfig.ROUND_RECORDER_60FPS.getValue()) {
+                    fpsRange = desu.inugram.helpers.chat.RoundRecorderHelper.selectFpsRange(cameraCharacteristics, true);
+                } else {
+                    fpsRange = new Range<Integer>(30, 30);
+                }
+                negotiatedFps = fpsRange.getUpper();
+                captureRequestBuilder.set(CaptureRequest.CONTROL_AE_TARGET_FPS_RANGE, fpsRange);
                 captureRequestBuilder.set(CaptureRequest.CONTROL_CAPTURE_INTENT, CaptureRequest.CONTROL_CAPTURE_INTENT_VIDEO_RECORD);
             }
 
+            // Exposure locking is a recorder-only affordance. Applying it to the preview
+            // request path on the same session can pin the sensor/exposure pipeline and
+            // make the follow-up record/send chain stall or fail. Keep the lock scoped to
+            // video capture and let the preview path continue with normal AE.
+            if (recordingVideo) {
+                Boolean aeLockAvailable = cameraCharacteristics != null ? cameraCharacteristics.get(CameraCharacteristics.CONTROL_AE_LOCK_AVAILABLE) : null;
+                if (aeLockAvailable == null || aeLockAvailable) {
+                    boolean lock = aeLocked || desu.inugram.InuConfig.ROUND_RECORDER_LOCK_EXPOSURE.getValue();
+                    captureRequestBuilder.set(CaptureRequest.CONTROL_AE_LOCK, lock);
+                }
+            }
+
             if (sensorSize != null && Math.abs(currentZoom - 1f) >= 0.01f) {
                 final int centerX = sensorSize.width() / 2;
                 final int centerY = sensorSize.height() / 2;
