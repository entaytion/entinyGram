+                        playSoundEffect(SoundEffectConstants.CLICK);
+                        delegate.didPressImage(this, lastTouchX, lastTouchY, false);
+                    } else if (buttonState == -1 || buttonState == 1 && isRoundVideo || buttonState == 2 || buttonState == 3 || drawVideoImageButton) {
                         playSoundEffect(SoundEffectConstants.CLICK);
