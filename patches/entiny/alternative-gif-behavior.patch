@@ -24317,4 +24322,22 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
             blurredPhotoImage.setImageBitmap((Bitmap) null);
         }
     }
+
+    private void inu_stopGifAnimation() {
+        buttonState = 2;
+        currentMessageObject.gifState = 1;
+        photoImage.setAllowStartAnimation(false);
+        photoImage.stopAnimation();
+        radialProgress.setIcon(getIconForCurrentState(), false, true);
+        invalidate();
+        playSoundEffect(SoundEffectConstants.CLICK);
+    }
+
+    private boolean inu_canOpenGifViewer() {
+        if (currentMessageObject == null || !currentMessageObject.isGif() || !(currentMessageObject.mediaExists() || currentMessageObject.attachPathExists)) {
+            return false;
+        }
+        String fileName = currentMessageObject.attachPathExists && !TextUtils.isEmpty(currentMessageObject.messageOwner.attachPath) ? currentMessageObject.messageOwner.attachPath : currentMessageObject.getFileName();
+        return !FileLoader.getInstance(currentAccount).isLoadingFile(fileName);
+    }
 }
