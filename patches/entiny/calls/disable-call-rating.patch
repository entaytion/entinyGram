diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voip/VoIPService.java b/TMessagesProj/src/main/java/org/telegram/messenger/voip/VoIPService.java
index 0000000..0000000 100755
--- a/TMessagesProj/src/main/java/org/telegram/messenger/voip/VoIPService.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/voip/VoIPService.java
@@ -1809,6 +1809,9 @@ public class VoIPService extends Service implements SensorEventListener, AudioMa
 	}
 
 	private void startRatingActivity() {
+		if (desu.inugram.InuConfig.DISABLE_CALL_RATING.getValue()) {
+			return;
+		}
 		try {
 			PendingIntent.getActivity(VoIPService.this, 0, new Intent(VoIPService.this, VoIPFeedbackActivity.class)
 					.putExtra("call_id", privateCall.id)
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/VoIPFragment.java b/TMessagesProj/src/main/java/org/telegram/ui/VoIPFragment.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/VoIPFragment.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/VoIPFragment.java
@@ -1893,8 +1893,10 @@ public class VoIPFragment implements
                         }, false);
                     }
 
-                    rateCallLayout.setVisibility(View.VISIBLE);
-                    rateCallLayout.show(count -> selectedRating = count);
+                    if (!desu.inugram.InuConfig.DISABLE_CALL_RATING.getValue()) {
+                        rateCallLayout.setVisibility(View.VISIBLE);
