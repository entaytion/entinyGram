+    public static void inu_keepReadReactions(TLRPC.MessageReactions old, TLRPC.MessageReactions incoming) {
+        if (old == null || incoming == null || old == incoming || old.recent_reactions == null || incoming.recent_reactions == null) {
+            return;
+        }
+        for (int i = 0; i < incoming.recent_reactions.size(); i++) {
+            TLRPC.MessagePeerReaction reaction = incoming.recent_reactions.get(i);
+            if (!reaction.unread) {
+                continue;
+            }
+            for (int j = 0; j < old.recent_reactions.size(); j++) {
+                TLRPC.MessagePeerReaction oldReaction = old.recent_reactions.get(j);
+                if (!oldReaction.unread && oldReaction.date == reaction.date && getPeerId(oldReaction.peer_id) == getPeerId(reaction.peer_id) && ReactionsLayoutInBubble.equalsTLReaction(oldReaction.reaction, reaction.reaction)) {
+                    reaction.unread = false;
+                    break;
+                }
+            }
+        }
+    }
