+    public void inu_markMessageReactionsAsRead(long dialogId, long topicId, int messageId, boolean hadUnread) {
+        final boolean report = messageId > 0 && !DialogObject.isEncryptedDialog(dialogId);
+        final boolean[] needRepair = new boolean[1];
+        getMessagesStorage().inu_markMessageReactionsAsRead(dialogId, topicId, messageId, rowState -> {
+            if (hadUnread && rowState == 1) {
+                checkUnreadReactionsInternal2(dialogId, topicId, false, true, -1, null);
+            } else if (!hadUnread || rowState == -1) {
+                if (report) {
+                    needRepair[0] = true;
+                } else {
+                    inu_repairUnreadReactionsCount(dialogId, topicId);
+                }
+            } else {
+                inu_postUnreadReactionsCount(dialogId, topicId);
+            }
+        });
+        if (!report) {
+            return;
+        }
+        final TLObject request;
+        TLRPC.Chat chat = DialogObject.isChatDialog(dialogId) ? getChat(-dialogId) : null;
+        if (ChatObject.isChannel(chat)) {
+            TLRPC.TL_channels_readMessageContents req = new TLRPC.TL_channels_readMessageContents();
+            req.channel = getInputChannel(chat);
+            req.id.add(messageId);
+            request = req;
+        } else {
+            TLRPC.TL_messages_readMessageContents req = new TLRPC.TL_messages_readMessageContents();
+            req.id.add(messageId);
+            request = req;
+        }
+        final String key = dialogId + "_" + messageId;
+        inu_pendingReactionReads.merge(key, 1, Integer::sum);
+        getConnectionsManager().sendRequest(request, (response, error) -> {
+            inu_pendingReactionReads.computeIfPresent(key, (k, v) -> v > 1 ? v - 1 : null);
+            if (response instanceof TLRPC.TL_messages_affectedMessages) {
+                TLRPC.TL_messages_affectedMessages res = (TLRPC.TL_messages_affectedMessages) response;
+                processNewDifferenceParams(-1, res.pts, -1, res.pts_count);
+            }
+            getMessagesStorage().getStorageQueue().postRunnable(() -> {
+                if (needRepair[0]) {
+                    inu_repairUnreadReactionsCount(dialogId, topicId);
+                }
+            });
+        });
+    }
+
+    private void inu_repairUnreadReactionsCount(long dialogId, long topicId) {
+        if (getMessagesStorage().inu_getUnreadReactionsCountSync(dialogId, topicId) != 0) {
+            checkUnreadReactionsInternal2(dialogId, topicId, true, false, 0, null);
+        } else {
+            inu_postUnreadReactionsCount(dialogId, topicId);
+        }
+    }
+
+    private void inu_postUnreadReactionsCount(long dialogId, long topicId) {
+        AndroidUtilities.runOnUIThread(() -> {
+            final int count;
+            if (topicId == 0) {
+                TLRPC.Dialog dialog = dialogs_dict.get(dialogId);
+                if (dialog == null) {
+                    return;
+                }
+                count = dialog.unread_reactions_count;
+            } else {
+                TLRPC.TL_forumTopic topic = getTopicsController().findTopic(-dialogId, topicId);
+                if (topic == null) {
+                    return;
+                }
+                count = topic.unread_reactions_count;
+            }
+            getNotificationCenter().postNotificationName(NotificationCenter.dialogsUnreadReactionsCounterChanged, dialogId, topicId, count, null);
+        });
+    }
+
+    public void inu_ignoreStaleUnreadReactions(long dialogId, int messageId, TLRPC.TL_messageReactions reactions, boolean willCheck) {
+        if (!MessageObject.hasUnreadReactions(reactions)) {
+            return;
+        }
+        if (inu_pendingReactionReads.containsKey(dialogId + "_" + messageId)) {
+            for (int i = 0; i < reactions.recent_reactions.size(); i++) {
+                reactions.recent_reactions.get(i).unread = false;
+            }
+            return;
+        }
+        TLRPC.Message stored = getMessagesStorage().getMessage(dialogId, messageId);
+        if (stored != null) {
+            MessageObject.inu_keepReadReactions(stored.reactions, reactions);
+            if (willCheck && !MessageObject.hasUnreadReactions(stored) && MessageObject.hasUnreadReactions(reactions)) {
+                inu_newUnreadReactions.add(dialogId + "_" + messageId);
+            }
+        }
+    }
