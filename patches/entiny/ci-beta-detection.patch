From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Sat, 29 Aug 2026 23:55:14 +0300
Subject: [*] detect CI beta builds with one application ID

---
 .../src/main/java/org/telegram/messenger/BuildVars.java        | 3 ++-
 TMessagesProj_App/build.gradle                                 | 1 -
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java b/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java
@@ -84,7 +84,8 @@ public class BuildVars {
     private static Boolean betaApp;
     public static boolean isBetaApp() {
         if (betaApp == null) {
-            betaApp = ApplicationLoader.applicationContext != null && "org.telegram.messenger.beta".equals(ApplicationLoader.applicationContext.getPackageName());
+            // CI sets INU_BUILD_TYPE to distinguish beta builds from releases that share one application ID.
+            betaApp = "beta".equals(BuildConfig.INU_BUILD_TYPE);
         }
         return betaApp;
     }
diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -66,7 +66,6 @@ android {
             debuggable true
             jniDebuggable true
             signingConfig signingConfigs.release
-            applicationIdSuffix ".beta"
             minifyEnabled false
             shrinkResources false
             multiDexEnabled true
