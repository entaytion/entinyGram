From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Sat, 10 Oct 2026 11:09:09 +0300
Subject: stop topics panel redraw storm

---
 .../src/main/java/org/telegram/ui/ChatActivity.java        | 4 +++-
 .../java/org/telegram/ui/RightSlidingDialogContainer.java  | 7 ++++++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -5056,7 +5056,9 @@ public class ChatActivity extends BaseFragment implements
                 }
                 final int action = e.getActionMasked();
                 if (action == MotionEvent.ACTION_DOWN) {
-                    topicsPanelMaybeSwipe = !inPreviewMode && !hasTextSelection() && e.getX() >= getMeasuredWidth() * 0.55f;
+                    final View pressed = getPressedChildView();
+                    final boolean onMessageBubble = pressed instanceof ChatMessageCell && ((ChatMessageCell) pressed).isInsideBackground(e.getX() - pressed.getX(), e.getY() - pressed.getY());
+                    topicsPanelMaybeSwipe = !onMessageBubble && !inPreviewMode && !hasTextSelection() && e.getX() >= getMeasuredWidth() * 0.55f;
                     if (!topicsPanelMaybeSwipe) {
                         topicsPanelSwiping = false;
                         return false;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/RightSlidingDialogContainer.java b/TMessagesProj/src/main/java/org/telegram/ui/RightSlidingDialogContainer.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/RightSlidingDialogContainer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/RightSlidingDialogContainer.java
@@ -493,6 +493,8 @@ public abstract class RightSlidingDialogContainer extends FrameLayout {
     }
 
     private Paint actionModePaint;
+    // entiny: searchFieldVisibleAlpha can stay stuck above 0 after a cancelled animator, and this draw re-invalidated forever
+    private float lastCompositeAlpha = -1f;
 
     @Override
     protected boolean drawChild(Canvas canvas, View child, long drawingTime) {
@@ -542,7 +544,10 @@ public abstract class RightSlidingDialogContainer extends FrameLayout {
                 currentActionBarView.draw(canvas);
             }
             canvas.restore();
-            invalidate();
+            if (alpha != lastCompositeAlpha) {
+                lastCompositeAlpha = alpha;
+                invalidate();
+            }
         }
     }
 
