+    private void requestCustomTranslate() {
+        final int generation = ++customRequestGeneration;
+        if (onUseListener != null) button.setLoading(true);
+        final SpannableStringBuilder loadingText = new SpannableStringBuilder(getString(R.string.Loading));
+        loadingText.setSpan(new LoadingSpan(null, dp(120), 0), 0, loadingText.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        translated = loadingText;
+        translatedLoading = true;
+        adapter.update(true);
+        translationRequest.run(to_lang, result -> AndroidUtilities.runOnUIThread(() -> {
+            if (isDismissed() || generation != customRequestGeneration) return;
+            button.setLoading(false);
+            if (result == null || result.length() == 0) {
+                translated = null;
+                button.setText(getString(R.string.OK));
+                button.setOnClickListener(v -> dismiss());
+            } else {
+                translated = result;
+                translatedLoading = false;
+            }
+            adapter.update(true);
+        }));
+    }
