From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Sun, 27 Sep 2026 21:50:04 +0300
Subject: slow animated previews in chats

---
 .../org/telegram/ui/Components/AnimatedFileDrawable.java  | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/AnimatedFileDrawable.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/AnimatedFileDrawable.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/AnimatedFileDrawable.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/AnimatedFileDrawable.java
@@ -1310,7 +1310,9 @@ public final class AnimatedFileDrawable extends BitmapDrawable implements Animat
 
     @UiThread
     private void updateCurrentFrameInternal(long now, boolean updateInBackground) {
-        final boolean canSwapBuffers = swapBuffersAllowedByChoreographer && Math.abs(now - lastFrameTime) >= invalidateAfter
+        // entiny: half-vsync tolerance; exact >= gate loses against vsync grid rounding (49.998 < 50)
+        // and pushes every swap one tick later, halving playback speed in chats
+        final boolean canSwapBuffers = swapBuffersAllowedByChoreographer && Math.abs(now - lastFrameTime) >= invalidateAfter - 8
             || !isRunning && decodeSingleFrame;
 
         if (isRunning) {
@@ -1334,7 +1336,9 @@ public final class AnimatedFileDrawable extends BitmapDrawable implements Animat
         renderingBuffer = nextRenderingBuffer;
         nextRenderingBuffer = nextRenderingBuffer2;
         nextRenderingBuffer2 = null;
-        lastFrameTime = now;
+        // entiny: carry the frame grid so vsync-aligned swaps do not drop 21-29 fps sources to 20 fps
+        final long target = lastFrameTime + invalidateAfter;
+        lastFrameTime = lastFrameTime != 0 && now >= target - 8 && now - target < 100 ? target : now;
         swapBuffersAllowedByChoreographer = false;
     }
 
