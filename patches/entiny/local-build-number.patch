From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Mon, 3 Aug 2026 20:25:45 +0300
Subject: Auto-increment local build code and ignore release output

---
 TMessagesProj_App/.gitignore |  3 ++-
 build.gradle                 | 29 +++++++++++++++++++++++++++--
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj_App/.gitignore b/TMessagesProj_App/.gitignore
index 0000000..0000000 100644
--- a/TMessagesProj_App/.gitignore
+++ b/TMessagesProj_App/.gitignore
@@ -1 +1,2 @@
-/build
\ No newline at end of file
+/build
+/release
\ No newline at end of file
diff --git a/build.gradle b/build.gradle
index 0000000..0000000 100644
--- a/build.gradle
+++ b/build.gradle
@@ -17,11 +17,36 @@ repositories {
     google()
 }
 
-def commitId = System.getenv('COMMIT_ID')
+def getGitCommitSha = {
+    try {
+        def process = ['git', 'rev-parse', '--short', 'HEAD'].execute(null, rootDir)
+        process.waitFor()
+        if (process.exitValue() == 0) return process.text.trim()
+    } catch (Exception ignored) {}
+    return null
+}
+
+def getNextLocalBuildNumber = {
+    def file = new File(rootDir, '.local_build_number')
+    int current = 1000000
+    if (file.exists()) {
+        try {
+            current = file.text.trim().toInteger()
+        } catch (Exception ignored) {}
+    }
+    int next = current + 1
+    try {
+        file.text = next.toString()
+    } catch (Exception ignored) {}
+    return current
+}
+
+def commitId = System.getenv('COMMIT_ID') ?: getGitCommitSha()
+def currentVerCode = System.getenv('INU_BUILD') ? Integer.parseInt(System.getenv('INU_BUILD')) : getNextLocalBuildNumber()
 
 ext {
   verName = "${APP_VERSION_NAME}${commitId != null ? "-${commitId.take(7)}" : ''}"
-  verCode = Integer.parseInt(System.getenv('INU_BUILD') ?: '1000000')
+  verCode = currentVerCode
   stockVerCode = Integer.parseInt(APP_VERSION_CODE)
   buildDate = java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ISO_DATE)
   ccachePath = null
