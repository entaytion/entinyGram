         boolean centerChatTitle = isCenteredTitle();
         boolean marquee = desu.inugram.InuConfig.CHAT_TITLE_MARQUEE.getValue();
         float baseSizePx = dp(glassMode ? 17.5f : 18);
-        if (Math.abs(titleTextView.getTextPaint().getTextSize() - baseSizePx) > 0.5f) {
+        if (isIosStyle()) {
+            inu_applyAdaptiveTitleSize(availableWidth, baseSizePx);
+        } else if (Math.abs(titleTextView.getTextPaint().getTextSize() - baseSizePx) > 0.5f) {
             titleTextView.setTextSizePx((int) baseSizePx);
         }
         avatarImageView.measure(MeasureSpec.makeMeasureSpec(dp(avatarSizeInDp) - 2, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(dp(avatarSizeInDp) - 2, MeasureSpec.EXACTLY));
@@ -716,6 +718,24 @@ public class ChatAvatarContainer extends FrameLayout implements FactorAnimator.T
         lastWidth = width;
     }

+    private static final float INU_ADAPTIVE_TITLE_MIN_SIZE_DP = 13.5f;
+
+    private void inu_applyAdaptiveTitleSize(int availableWidth, float baseSizePx) {
+        float minSizePx = dp(INU_ADAPTIVE_TITLE_MIN_SIZE_DP);
+        float sizePx = baseSizePx;
+        if (Math.abs(titleTextView.getTextPaint().getTextSize() - sizePx) > 0.5f) {
+            titleTextView.setTextSizePx((int) sizePx);
+        }
+        if (availableWidth <= 0 || TextUtils.isEmpty(titleTextView.getText())) {
+            return;
+        }
+        float stepPx = dp(1);
+        while (sizePx > minSizePx && titleTextView.getExactWidthIncludeDrawables() > availableWidth) {
+            sizePx = Math.max(minSizePx, sizePx - stepPx);
+            titleTextView.setTextSizePx((int) sizePx);
+        }
+    }
+
     private void fadeOutToLessWidth(int largerWidth) {
         this.largerWidth = largerWidth;
         SimpleTextView titleTextLargerCopyView = this.titleTextLargerCopyView.get();
