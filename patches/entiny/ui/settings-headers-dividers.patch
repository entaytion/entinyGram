+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/UniversalRecyclerView.java
@@ -438,7 +438,7 @@ public class UniversalRecyclerView extends RecyclerListView {
             view -> {
                 if (view.getParent() != this) return false;
                 final ViewHolder viewHolder = getChildViewHolder(view);
-                return !UniversalAdapter.isShadow(viewHolder.getItemViewType());
+                return !UniversalAdapter.isShadow(viewHolder.getItemViewType()) && !desu.inugram.helpers.theme.M3SectionsHelper.isOrphanHeader(getAdapter(), viewHolder.getAdapterPosition(), viewHolder.getItemViewType());
             },
             UniversalAdapter::isShadow,
             padding, roundRadius,
