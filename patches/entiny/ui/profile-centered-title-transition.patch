From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Mon, 9 Nov 2026 14:26:59 +0200
Subject: Fix centered title transition to profile

---
 .../java/org/telegram/ui/ProfileActivity.java    | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -10445,6 +10445,22 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
             prevAvatarTranslation = 0;
             prevTitleTranslation = 0;
             prevSubtitleTranslation = 0;
+            if (desu.inugram.InuConfig.CENTER_TITLE_CHATS.getValue() && previousTransitionFragment instanceof ChatActivity) {
+                ChatAvatarContainer chatHeader = ((ChatActivity) previousTransitionFragment).getAvatarContainer();
+                if (chatHeader != null && chatHeader.getTitleTextView() != null) {
+                    int[] location = new int[2];
+                    int[] origin = new int[2];
+                    fragmentView.getLocationInWindow(origin);
+                    SimpleTextView title = chatHeader.getTitleTextView();
+                    title.getLocationInWindow(location);
+                    prevTitleTranslation = location[0] - origin[0] + title.getTextStartX() - title.getX();
+                    View subtitle = chatHeader.getSubtitleTextView();
+                    if (subtitle instanceof SimpleTextView) {
+                        subtitle.getLocationInWindow(location);
+                        prevSubtitleTranslation = location[0] - origin[0] + ((SimpleTextView) subtitle).getTextStartX() - subtitle.getX();
+                    }
+                }
+            }
             final FrameLayout.LayoutParams onlineLayoutParams = (FrameLayout.LayoutParams) onlineTextView.getLayoutParams();
             onlineLayoutParams.rightMargin = (int) (-21 * AndroidUtilities.density + AndroidUtilities.dp(8));
             onlineTextView.setLayoutParams(onlineLayoutParams);
