From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Mon, 3 Aug 2026 18:05:26 +0300
Subject: Handle tg://settings deeplinks in chat messages and enlarge the AI star drawable

---
 .../src/main/java/org/telegram/ui/ChatActivity.java      | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -37840,6 +37840,10 @@ public class ChatActivity extends BaseFragment implements
     }
 
     private void processExternalUrl(int type, String url, CharacterStyle span, ChatMessageCell cell, boolean forceAlert, boolean forceNoIV) {
+        LaunchActivity launchActivity = getParentActivity() instanceof LaunchActivity ? (LaunchActivity) getParentActivity() : LaunchActivity.instance;
+        if (url != null && (url.startsWith("tg://settings/") || url.startsWith("tg:settings/")) && launchActivity != null && desu.inugram.SearchRegistry.tryHandleDeepLink(launchActivity, new Intent(Intent.ACTION_VIEW, Uri.parse(url)))) {
+            return;
+        }
         try {
             String host = AndroidUtilities.getHostAuthority(url);
             if ((currentEncryptedChat == null || getMessagesController().secretWebpagePreview == 1) && getMessagesController().authDomains.contains(host)) {
@@ -43614,6 +43618,11 @@ public class ChatActivity extends BaseFragment implements
     }
 
     private boolean openLinkInternally(String urlFinal, ChatMessageCell cell, CharacterStyle span, int fromMessageId, int fromMessageProgressType) {
+        if (urlFinal != null && (urlFinal.startsWith("tg://settings/") || urlFinal.startsWith("tg:settings/")) && getParentActivity() instanceof LaunchActivity) {
+            if (desu.inugram.SearchRegistry.tryHandleDeepLink((LaunchActivity) getParentActivity(), new Intent(Intent.ACTION_VIEW, Uri.parse(urlFinal)))) {
+                return true;
+            }
+        }
         if (currentChat == null || urlFinal == null || chatMode != 0) {
             return false;
         }
