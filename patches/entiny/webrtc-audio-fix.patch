+  private static @Nullable AudioDeviceInfo inu_preferredDevice;
+  private static @Nullable AudioTrack inu_currentTrack;
+
+  public static synchronized void inu_setPreferredDevice(@Nullable AudioDeviceInfo device) {
+    inu_preferredDevice = device;
+    if (Build.VERSION.SDK_INT >= 23 && inu_currentTrack != null) {
+      try {
+        inu_currentTrack.setPreferredDevice(device);
+      } catch (Throwable e) {
+        Logging.e(TAG, "inu_setPreferredDevice failed", e);
+      }
+    }
+  }
+
+  private static synchronized void inu_onAudioTrackCreated(AudioTrack track) {
+    inu_currentTrack = track;
+    if (Build.VERSION.SDK_INT >= 23 && inu_preferredDevice != null) {
+      try {
+        track.setPreferredDevice(inu_preferredDevice);
+      } catch (Throwable e) {
+        Logging.e(TAG, "inu_setPreferredDevice failed", e);
+      }
+    }
+  }
+
+  private static synchronized void inu_onAudioTrackReleased() {
+    inu_currentTrack = null;
+  }
+
   // Releases the native AudioTrack resources.
   private void releaseAudioResources() {
     Logging.e(TAG, "releaseAudioResources", new Exception());
