+    public desu.inugram.helpers.pillstack.PillStackController inu_pillStackController;
 
     public FragmentSearchField(Context context, Theme.ResourcesProvider resourcesProvider) {
         super(context);
@@ -304,6 +305,8 @@ public class FragmentSearchField extends FrameLayout implements FactorAnimator.T
             }
         }
 
+        if (inu_pillStackController != null) inu_pillStackController.updateColors();
+
         invalidate();
     }
 
