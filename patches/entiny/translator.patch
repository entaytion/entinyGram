index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/LanguageDetector.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/LanguageDetector.java
@@ -1,5 +1,7 @@
 package org.telegram.messenger;
 
+import android.os.Build;
+
 public class LanguageDetector {
     public interface StringCallback {
         void run(String str);
@@ -9,9 +11,58 @@ public class LanguageDetector {
     }
 
     public static boolean hasSupport() {
+        // MLKit's language-id native lib crashes (SIGABRT) when the app's ARM native libs
+        // run on an x86 emulator under ARM translation. Only skip detection in that case;
+        // real devices and native x86_64 emulator builds (ABI_FILTERS=x86_64) are safe.
+        if (isEmulator() && !isNativeX86()) {
+            return false;
+        }
         return true;
     }
 
+    private static boolean isEmulator() {
+        String fp = Build.FINGERPRINT;
+        if (fp != null && (fp.contains("generic") || fp.toLowerCase().contains("emulator"))) {
+            return true;
+        }
+        String model = Build.MODEL;
+        if (model != null && (model.contains("Emulator")
+                || model.contains("Android SDK built for")
+                || model.toLowerCase().contains("google_sdk"))) {
+            return true;
+        }
+        String brand = Build.BRAND;
+        if (brand != null && brand.toLowerCase().contains("generic")) {
+            return true;
+        }
+        String device = Build.DEVICE;
+        if (device != null && device.toLowerCase().contains("generic")) {
+            return true;
+        }
+        String hardware = Build.HARDWARE;
+        if (hardware != null && (hardware.contains("goldfish") || hardware.contains("ranchu"))) {
+            return true;
+        }
+        String product = Build.PRODUCT;
+        if (product != null && (product.contains("emulator") || product.contains("google_sdk"))) {
+            return true;
+        }
+        String manufacturer = Build.MANUFACTURER;
+        if (manufacturer != null && manufacturer.toLowerCase().contains("emulator")) {
+            return true;
+        }
+        String host = Build.HOST;
+        return host != null && host.toLowerCase().contains("emulator");
+    }
+
+    private static boolean isNativeX86() {
+        String[] abis = Build.SUPPORTED_ABIS;
+        if (abis != null && abis.length > 0) {
+            return abis[0].startsWith("x86");
+        }
+        return false;
+    }
+
     public static void detectLanguage(String text, StringCallback onSuccess, ExceptionCallback onFail) {
         detectLanguage(text, onSuccess, onFail, false);
     }
