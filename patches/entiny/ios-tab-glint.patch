+    private GradientDrawable inu_selectionGlint;
+    private ValueAnimator inu_glintAnimator;
+
+    public void inu_flashSelection() {
+        if (!SharedConfig.animationsEnabled() || (Build.VERSION.SDK_INT >= 26 && !ValueAnimator.areAnimatorsEnabled())) {
+            return;
+        }
+        if (inu_selectionGlint == null) {
+            inu_selectionGlint = new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+                    new int[] {0x80FFFFFF, 0x18FFFFFF, Color.TRANSPARENT});
+            inu_selectionGlint.setCornerRadius(dp(32));
+            inu_glintAnimator = ValueAnimator.ofInt(140, 0);
+            inu_glintAnimator.setDuration(140);
+            inu_glintAnimator.setInterpolator(AnimatorUtils.DECELERATE_INTERPOLATOR);
+            inu_glintAnimator.addUpdateListener(animation -> {
+                inu_selectionGlint.setAlpha((int) animation.getAnimatedValue());
+                invalidate();
+            });
+        }
+        inu_glintAnimator.cancel();
+        inu_glintAnimator.start();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (inu_glintAnimator != null) {
+            inu_glintAnimator.cancel();
+            inu_selectionGlint.setAlpha(0);
+        }
+        super.onDetachedFromWindow();
+    }
