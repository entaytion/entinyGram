From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oleksii Kulinich <entaytion@gmail.com>
Date: Tue, 18 Aug 2026 01:41:50 +0300
Subject: feat(privacy): allow screenshots when enabled

- remove secure-window protection only behind the screenshots setting
---
 .../main/java/org/telegram/messenger/FlagSecureReason.java  | 5 +++++
 .../java/org/telegram/ui/Components/PasscodeViewDialog.java | 6 ++++--
 .../src/main/java/org/telegram/ui/PhotoViewer.java          | 6 ++++--
 .../src/main/java/org/telegram/ui/SecretMediaViewer.java    | 6 ++++--
 .../src/main/java/org/telegram/ui/SecretVoicePlayer.java    | 6 ++++--
 5 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java b/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java
@@ -64,6 +64,11 @@ public class FlagSecureReason {
             return;
         }
 
+        if (desu.inugram.InuConfig.ALLOW_SCREENSHOTS.getValue()) {
+            window.clearFlags(WindowManager.LayoutParams.FLAG_SECURE);
+            return;
+        }
+
         if (isSecuredNow(window)) {
             window.addFlags(WindowManager.LayoutParams.FLAG_SECURE);
             AndroidUtilities.logFlagSecure();
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/PasscodeViewDialog.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/PasscodeViewDialog.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/PasscodeViewDialog.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/PasscodeViewDialog.java
@@ -82,8 +82,10 @@ public class PasscodeViewDialog extends Dialog {
         params.softInputMode = WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE;
 //        params.flags |= WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM;
         if (!BuildVars.DEBUG_PRIVATE_VERSION) {
-            params.flags |= WindowManager.LayoutParams.FLAG_SECURE;
-            AndroidUtilities.logFlagSecure();
+            if (!desu.inugram.InuConfig.ALLOW_SCREENSHOTS.getValue()) {
+                params.flags |= WindowManager.LayoutParams.FLAG_SECURE;
+                AndroidUtilities.logFlagSecure();
+            }
         }
         params.flags |= WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN |
                 WindowManager.LayoutParams.FLAG_LAYOUT_INSET_DECOR |
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/PhotoViewer.java b/TMessagesProj/src/main/java/org/telegram/ui/PhotoViewer.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/PhotoViewer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/PhotoViewer.java
@@ -17574,8 +17574,10 @@ public class PhotoViewer implements NotificationCenter.NotificationCenterDelegat
                 messageObject != null && (MessagesController.getInstance(currentAccount).isPeerNoForwards(messageObject.getDialogId()) ||
                 (messageObject.messageOwner != null && messageObject.messageOwner.noforwards)) || messageObject != null && messageObject.hasRevealedExtendedMedia()
             ) {
-                windowLayoutParams.flags |= WindowManager.LayoutParams.FLAG_SECURE;
-                AndroidUtilities.logFlagSecure();
+                if (!desu.inugram.InuConfig.ALLOW_SCREENSHOTS.getValue()) {
+                    windowLayoutParams.flags |= WindowManager.LayoutParams.FLAG_SECURE;
+                    AndroidUtilities.logFlagSecure();
+                }
             } else {
                 windowLayoutParams.flags &=~ WindowManager.LayoutParams.FLAG_SECURE;
                 AndroidUtilities.logFlagSecure();
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java b/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java
@@ -977,8 +977,10 @@ public class SecretMediaViewer implements NotificationCenter.NotificationCenterD
                 WindowManager.LayoutParams.FLAG_LAYOUT_INSET_DECOR |
                 WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE |
                 WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS;
-        windowLayoutParams.flags |= WindowManager.LayoutParams.FLAG_SECURE;
-        AndroidUtilities.logFlagSecure();
+        if (!desu.inugram.InuConfig.ALLOW_SCREENSHOTS.getValue()) {
+            windowLayoutParams.flags |= WindowManager.LayoutParams.FLAG_SECURE;
+            AndroidUtilities.logFlagSecure();
+        }
         centerImage.setParentView(containerView);
         centerImage.setForceCrossfade(true);
 
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java b/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java
@@ -239,8 +239,10 @@ public class SecretVoicePlayer extends Dialog {
             WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS |
             WindowManager.LayoutParams.FLAG_TRANSLUCENT_NAVIGATION;
         if (!BuildVars.DEBUG_PRIVATE_VERSION) {
-            params.flags |= WindowManager.LayoutParams.FLAG_SECURE;
-            AndroidUtilities.logFlagSecure();
+            if (!desu.inugram.InuConfig.ALLOW_SCREENSHOTS.getValue()) {
+                params.flags |= WindowManager.LayoutParams.FLAG_SECURE;
+                AndroidUtilities.logFlagSecure();
+            }
         }
         params.flags |= WindowManager.LayoutParams.FLAG_FULLSCREEN;
         params.flags |= WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON;
