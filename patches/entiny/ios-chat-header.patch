+    // inu: centered chat header - CherryGram-style adaptive pill.
+    //
+    // The pill's geometry is a pure function of the action bar's own fixed slots (back button,
+    // menu items) and of the PAINT-measured width of title/subtitle.
+    // ChatAvatarContainer then lays its text out INTO that pill - never the other way round.
+    // Reading the pill back off the text's laid-out position, as this used to, double-counted
+    // the title's own centering bias (the pill drifted half a verified-badge to the right of
+    // the text it was wrapping) and sized itself from a layout-dependent text width that
+    // under-reported freshly-set subtitles, so long subtitles spilled out of both pill ends.
+    //
+    // Two rectangles come out of updateGlassBounds():
+    //   inu_titlePillLeft/Right  - the SETTLED target. Text measures and lays out against this,
+    //                              so the text never has to chase an animating box.
+    //   inu_glassTitleLeft/Right - the same rectangle with an animated width, drawn as glass.
+    // They share a center, so they stay concentric while the width animates.
+    public int inu_titlePillLeft;
+    public int inu_titlePillRight;
+    private final FactorAnimator inu_animatorPillWidth = new FactorAnimator(0, this, CubicBezierInterpolator.EASE_OUT_QUINT, 320);
+
+    // Padding between a pill edge and the text inside it, before any avatar room is added on top
+    // of it - see inu_getPillTextInsetLeft/Right for how that room is distributed.
+    private static final int INU_PILL_TEXT_PADDING_DP = 16;
+    private static final int INU_PILL_MIN_WIDTH_DP = 120;
+    // Breathing room on top of the measured text. inu_getCenteredTextWidth() measures with
+    // Paint#measureText on the plain String, while SimpleTextView ellipsizes against its
+    // StaticLayout's getLineWidth() - the latter comes out a hair wider (rounding, kerning, any
+    // span the String conversion dropped). Sized to the text exactly, that difference was enough
+    // to trip setEllipsizeByGradient and fade the tail of a subtitle that actually fit.
+    private static final int INU_PILL_TEXT_SLACK_DP = 3;
+
+    // Distance from a pill edge to the text inside it, avatar room included when the avatar sits
+    // inside the pill. Public because ChatAvatarContainer derives its own text band from it.
+    //
+    // The room is reserved on BOTH sides only while the pill spans the whole free room: there the
+    // pill's width is fixed, so the symmetric reservation is what keeps the text centered in it
+    // and the dead space opposite the avatar is invisible. A compact pill is sized to its own
+    // content, so doing the same there inflated it by a whole extra avatar width and left the
+    // avatar hugging one edge with a void facing it across the text. Compact reserves the room
+    // only on the side the avatar is actually on, so the pill hugs [avatar][text] as one block.
+    private int inu_pillAvatarRoom() {
+        return chatAvatarContainer != null ? chatAvatarContainer.inu_getPillAvatarRoom() : 0;
+    }
+
+    private boolean inu_pillAvatarOnRight() {
+        return chatAvatarContainer != null && chatAvatarContainer.isRightAvatar();
+    }
+
+    public int inu_getPillTextInsetLeft() {
+        final int room = inu_pillAvatarRoom();
+        if (room == 0) {
+            return dp(INU_PILL_TEXT_PADDING_DP);
+        }
+        final boolean symmetric = !desu.inugram.helpers.InuUtils.compactChatPill();
+        return dp(INU_PILL_TEXT_PADDING_DP) + (symmetric || !inu_pillAvatarOnRight() ? room : 0);
+    }
+
+    public int inu_getPillTextInsetRight() {
+        final int room = inu_pillAvatarRoom();
+        if (room == 0) {
+            return dp(INU_PILL_TEXT_PADDING_DP);
+        }
+        final boolean symmetric = !desu.inugram.helpers.InuUtils.compactChatPill();
+        return dp(INU_PILL_TEXT_PADDING_DP) + (symmetric || inu_pillAvatarOnRight() ? room : 0);
+    }
+
     public void setupGlass(BlurredBackgroundDrawableViewFactory factory, BlurredBackgroundColorProvider colorProvider) {
