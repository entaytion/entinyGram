@@ -320,6 +320,24 @@ public class SimpleTextView extends View implements Drawable.Callback {
         return size;
     }
 
+    // inu: how far a CENTER-gravity layout box has to move so that the NAME - the text together
+    // with anything that leads it - lands on the box's centre, instead of the whole
+    // (leftDrawable | text | rightDrawables) unit that calcOffset() below actually centres.
+    //
+    // Only the TRAILING drawables are discounted. They are decorations that follow the name
+    // (verified check, premium star, emoji status, muted bell): reserving their width inside the
+    // centred unit drags the readable word left of centre for no reason the reader can see, so
+    // half of them is given back and they hang off the right instead. A LEADING drawable is a
+    // different thing - the chat header's is the bot-verification slot, which is where our own
+    // developer badge is written, and it reads as part of the name. Discounting it too (which
+    // "half of every side drawable" and even "(right - left) / 2" both did, in opposite
+    // directions) centres the bare word and leaves the badge hanging out into the left margin,
+    // which is exactly what reads as "the badge is not centred".
+    public int getCenteringDrawableBias() {
+        final int left = leftDrawable != null ? leftDrawable.getIntrinsicWidth() + drawablePadding : 0;
+        return Math.max(0, getSideDrawablesSize() - left) / 2;
+    }
+
     public TextPaint getPaint() {
         return textPaint;
     }
