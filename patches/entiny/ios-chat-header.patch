+    // inu: centered chat header - CherryGram-style adaptive pill.
+    //
+    // The pill's geometry is a pure function of the action bar's own fixed slots (back button
+    // plus its unread badge, menu items) and of the PAINT-measured width of title/subtitle.
+    // ChatAvatarContainer then lays its text out INTO that pill - never the other way round.
+    // Reading the pill back off the text's laid-out position, as this used to, double-counted
+    // the title's own centering bias (the pill drifted half a verified-badge to the right of
+    // the text it was wrapping) and sized itself from a layout-dependent text width that
+    // under-reported freshly-set subtitles, so long subtitles spilled out of both pill ends.
+    //
+    // Two rectangles come out of updateGlassBounds():
+    //   inu_titlePillLeft/Right  - the SETTLED target. Text measures and lays out against this,
+    //                              so the text never has to chase an animating box.
+    //   inu_glassTitleLeft/Right - the same rectangle with an animated width, drawn as glass.
+    // They share a center, so they stay concentric while the width animates.
+    public int inu_titlePillLeft;
+    public int inu_titlePillRight;
+    private final FactorAnimator inu_animatorPillWidth = new FactorAnimator(0, this, CubicBezierInterpolator.EASE_OUT_QUINT, 320);
+
+    // Padding between a pill edge and the text inside it, before any avatar room is added on top
+    // of it - see inu_getPillTextInsetLeft/Right for how that room is distributed.
+    private static final int INU_PILL_TEXT_PADDING_DP = 16;
+    private static final int INU_PILL_MIN_WIDTH_DP = 120;
+    // Breathing room on top of the measured text. inu_getCenteredTextWidth() measures with
+    // Paint#measureText on the plain String, while SimpleTextView ellipsizes against its
+    // StaticLayout's getLineWidth() - the latter comes out a hair wider (rounding, kerning, any
+    // span the String conversion dropped). Sized to the text exactly, that difference was enough
+    // to trip setEllipsizeByGradient and fade the tail of a subtitle that actually fit.
+    private static final int INU_PILL_TEXT_SLACK_DP = 3;
+
+    // CherryGram-style unread counter growing out of the back button. The counter's own measured
+    // width feeds inu_animatorBackPillGrowth, which updateGlassBounds() reads to make room.
+    private CounterView inu_backCounterView;
+    private final FactorAnimator inu_animatorBackPillGrowth = new FactorAnimator(0, this, CubicBezierInterpolator.EASE_OUT_QUINT, 320);
+    private boolean inu_backCounterVisible;
+    private int inu_backUnreadCount;
+
+    private void inu_ensureBackCounterView() {
+        if (inu_backCounterView != null) {
+            return;
+        }
+        // CounterView re-measures itself asynchronously after setCount(), so a growth target read
+        // straight after setCount() would still be the previous count's width. CherryGram hooks
+        // invalidate() for exactly this reason.
+        inu_backCounterView = new CounterView(getContext(), resourcesProvider) {
+            @Override
+            public void invalidate() {
+                super.invalidate();
+                inu_updateBackPillGrowth(true);
+            }
+        };
+        inu_backCounterView.setVisibility(VISIBLE);
+        inu_backCounterView.setColors(Theme.key_chats_unreadCounterText, Theme.key_chats_unreadCounter);
+        inu_backCounterView.setGravity(Gravity.LEFT);
+        inu_backCounterView.setScaleX(0f);
+        inu_backCounterView.setScaleY(0f);
+        inu_backCounterView.setAlpha(0f);
+        addView(inu_backCounterView, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, 20, Gravity.LEFT | Gravity.CENTER_VERTICAL, 44, 0, 0, 0));
+    }
+
+    // Called by ChatHelper.updateUnreadBackBadge() whenever the total unread count or the
+    // centered-title state might have changed. count <= 0 or the feature being off just hides it.
+    public void inu_setBackUnreadCount(int count) {
+        if (!desu.inugram.InuConfig.UNREAD_BADGE_BACK_BUTTON.getValue()) {
+            count = 0;
+        }
+        if (count > 0) {
+            inu_ensureBackCounterView();
+        }
+        inu_backUnreadCount = Math.max(0, count);
+        if (inu_backCounterView != null) {
+            inu_backCounterView.setCount(Math.min(999, inu_backUnreadCount), true);
+        }
+        inu_updateBackPillGrowth(true);
+    }
+
+    private boolean inu_backCounterShown() {
+        return inu_backCounterView != null
+                && desu.inugram.InuConfig.UNREAD_BADGE_BACK_BUTTON.getValue()
+                && inu_backUnreadCount > 0
+                && chatAvatarContainer != null && chatAvatarContainer.isTitleCenteredMode()
+                && !isActionModeShowed()
+                && !isSearchFieldVisible;
+    }
+
+    private void inu_updateBackPillGrowth(boolean animated) {
+        if (inu_backCounterView == null) {
+            return;
+        }
+        final boolean show = inu_backCounterShown();
+        // Only (re)run the pop-in on an actual state change - this is reached from the counter's
+        // own invalidate(), i.e. potentially every frame, and restarting the animator there would
+        // pin the badge at its start scale forever.
+        if (inu_backCounterVisible != show) {
+            inu_backCounterVisible = show;
+            inu_backCounterView.animate().cancel();
+            if (animated) {
+                inu_backCounterView.animate().scaleX(show ? 1f : 0f).scaleY(show ? 1f : 0f).alpha(show ? 1f : 0f).setDuration(220).start();
+            } else {
+                inu_backCounterView.setScaleX(show ? 1f : 0f);
+                inu_backCounterView.setScaleY(show ? 1f : 0f);
+                inu_backCounterView.setAlpha(show ? 1f : 0f);
+            }
+        }
+        final int target = show ? Math.min(dp(35), Math.max(0, inu_backCounterView.getMeasuredWidth())) : 0;
+        if (animated) {
+            if (inu_animatorBackPillGrowth.getToFactor() != target) {
+                inu_animatorBackPillGrowth.animateTo(target);
+            }
+        } else {
+            inu_animatorBackPillGrowth.forceFactor(target);
+        }
+        invalidate();
+    }
+
+    // Extra room the unread badge takes out of the back-button slot. A FactorAnimator (not an
+    // AnimatedFloat) because updateGlassBounds() runs several times per frame - measure, layout
+    // and draw - and animateTo() is idempotent where AnimatedFloat.set() would advance the
+    // animation once per call and race ahead of real time.
+    private int inu_getBackPillGrowth() {
+        return Math.max(0, (int) inu_animatorBackPillGrowth.getFactor());
+    }
+
+    // Distance from a pill edge to the text inside it, avatar room included when the avatar sits
+    // inside the pill. Public because ChatAvatarContainer derives its own text band from it.
+    //
+    // The room is reserved on BOTH sides only while the pill spans the whole free room: there the
+    // pill's width is fixed, so the symmetric reservation is what keeps the text centered in it
+    // and the dead space opposite the avatar is invisible. A compact pill is sized to its own
+    // content, so doing the same there inflated it by a whole extra avatar width and left the
+    // avatar hugging one edge with a void facing it across the text. Compact reserves the room
+    // only on the side the avatar is actually on, so the pill hugs [avatar][text] as one block.
+    private int inu_pillAvatarRoom() {
+        return chatAvatarContainer != null ? chatAvatarContainer.inu_getPillAvatarRoom() : 0;
+    }
+
+    private boolean inu_pillAvatarOnRight() {
+        return chatAvatarContainer != null && chatAvatarContainer.isRightAvatar();
+    }
+
+    public int inu_getPillTextInsetLeft() {
+        final int room = inu_pillAvatarRoom();
+        if (room == 0) {
+            return dp(INU_PILL_TEXT_PADDING_DP);
+        }
+        final boolean symmetric = !desu.inugram.helpers.InuUtils.compactChatPill();
+        return dp(INU_PILL_TEXT_PADDING_DP) + (symmetric || !inu_pillAvatarOnRight() ? room : 0);
+    }
+
+    public int inu_getPillTextInsetRight() {
+        final int room = inu_pillAvatarRoom();
+        if (room == 0) {
+            return dp(INU_PILL_TEXT_PADDING_DP);
+        }
+        final boolean symmetric = !desu.inugram.helpers.InuUtils.compactChatPill();
+        return dp(INU_PILL_TEXT_PADDING_DP) + (symmetric || inu_pillAvatarOnRight() ? room : 0);
+    }
+
