     public void setupGlass(BlurredBackgroundDrawableViewFactory factory, BlurredBackgroundColorProvider colorProvider) {
         setupGlass(factory, colorProvider, false);
     }
@@ -2240,6 +2254,50 @@ public class ActionBar extends FrameLayout implements FactorAnimator.Target, The
 
     public boolean doNotDrawGlassMenu;
 
+    public int inu_getMenuWidth() {
+        return hasForcedMenuWidth ? forcedMenuWidth : (int) animatorMenuItemsWidth.getFactor();
+    }
+
+    public void updateGlassBounds(int width, int height) {
+        final int p = dp(6);
+        final int s = dp(46);
+        final int menuWidth = hasForcedMenuWidth ? forcedMenuWidth : (int) animatorMenuItemsWidth.getFactor();
+        final boolean hasBackButton = backButtonImageView != null && backButtonImageView.getVisibility() == View.VISIBLE;
+
+        final int t = height - (getCurrentActionBarHeight() + s) / 2 - p;
+        final int b = t + s + p * 2;
+
+        final int menuWidthWithPadding = menuWidth + (hasForcedMenuWidth ? (menuWidth > 0 ? p : 0) : (int) (p * animatorHasMenuItems.getFloatValue()));
+        final int rightOffset = menuWidthWithPadding;
+        int leftDefault = hasBackButton ? s + p : 0;
+        int rightDefault = width - rightOffset;
+
+        if (desu.inugram.InuConfig.IOS_CHAT_HEADER.getValue() && chatAvatarContainer != null && chatAvatarContainer.isTitleCenteredMode()) {
+            final int avatarLeft = chatAvatarContainer.getCenteredAvatarLeft();
+            final int rightLimit = avatarLeft > 0 ? Math.min(rightDefault, avatarLeft - p) : rightDefault;
+            final int centerX = Math.round(chatAvatarContainer.getLeft() + chatAvatarContainer.getTitlesCenterX());
+            final int symRoom = Math.max(dp(48), 2 * Math.min(centerX - leftDefault, rightLimit - centerX));
+            final int target = Math.min(symRoom, Math.max(dp(136), chatAvatarContainer.getTitlesWidth() + getCenteredTitlePillPadding()));
+            final int pillWidth = Math.round(inu_iosHeaderPillWidth.set(target));
+            leftDefault = centerX - pillWidth / 2;
+            rightDefault = leftDefault + pillWidth;
+        } else if (desu.inugram.InuConfig.CENTER_TITLE_FIXED.getValue() && chatAvatarContainer != null && chatAvatarContainer.isTitleCenteredMode()) {
+            // "Fixed" centering (exteraGram-style): always sit at the screen's true horizontal
+            // midpoint, sized to content but NOT clamped against leftDefault/rightDefault's real
+            // back-button/menu edges the way the default branch above is - it can overlap a wide
+            // back button or a busy menu on narrow headers. That's the accepted tradeoff.
+            final int pillWidth = Math.max(dp(48), Math.min(width, chatAvatarContainer.getTitlesWidth() + getCenteredTitlePillPadding()));
+            final int centerX = width / 2;
+            leftDefault = centerX - pillWidth / 2;
+            rightDefault = leftDefault + pillWidth;
+        }
+
+        inu_glassTitleLeft = leftDefault;
+        inu_glassTitleRight = rightDefault;
+        inu_glassTop = t;
+        inu_glassBottom = b;
+    }
+
