+        final boolean show = inu_backCounterShown();
+        inu_backCounterView.animate().cancel();
+        if (animated) {
+            inu_backCounterView.animate().scaleX(show ? 1f : 0f).scaleY(show ? 1f : 0f).alpha(show ? 1f : 0f).setDuration(220).start();
