@@ -2240,6 +2407,139 @@ public class ActionBar extends FrameLayout implements FactorAnimator.Target, The
 
     public boolean doNotDrawGlassMenu;
 
+    public void updateGlassBounds(int width, int height) {
+        final int p = dp(6);
+        final int s = dp(46);
+        final int menuWidth = hasForcedMenuWidth ? forcedMenuWidth : (int) animatorMenuItemsWidth.getFactor();
+        final boolean hasBackButton = backButtonImageView != null && backButtonImageView.getVisibility() == View.VISIBLE;
+
+        final int t = height - (getCurrentActionBarHeight() + s) / 2 - p;
+        final int b = t + s + p * 2;
+
+        final int menuWidthWithPadding = menuWidth + (hasForcedMenuWidth ? (menuWidth > 0 ? p : 0) : (int) (p * animatorHasMenuItems.getFloatValue()));
+        final int rightOffset = menuWidthWithPadding;
+
+        // The back button's own slot, WITHOUT its unread badge. Keeping the badge out of this
+        // reference is what makes the centered pill stay put when the badge appears or goes away;
+        // leftLimit below only pushes the pill when the grown badge would actually collide with it.
+        final int baseLeft = hasBackButton ? s + p : 0;
+        final int leftLimit = hasBackButton ? baseLeft + inu_getBackPillGrowth() : 0;
+        int leftDefault = leftLimit;
+        int rightDefault = width - rightOffset;
+
+        final int prevPillLeft = inu_titlePillLeft;
+        final int prevPillRight = inu_titlePillRight;
+
+        final boolean centered = chatAvatarContainer != null
+                && chatAvatarContainer.isTitleCenteredMode()
+                && !isSearchFieldVisible
+                && !isActionModeShowed();
+        if (centered) {
+            // The centered pill positions the container through inu_titlePill* instead of the
+            // stock translation below; drop a translation left over from search or action mode.
+            if (chatAvatarContainer.getTranslationX() != 0) {
+                chatAvatarContainer.setTranslationX(0);
+            }
+            final float inu_centeredTextWidth = chatAvatarContainer.inu_getCenteredTextWidth();
+            final int roomRight = Math.max(baseLeft + dp(INU_PILL_MIN_WIDTH_DP), rightDefault);
+
+            // Centered on the room between the two slots, never on the raw screen midpoint: the
+            // back button and the menu are not the same width, so a true-midpoint pill reads as
+            // off-centre against them and can overlap one of them outright.
+            final int centerX = (baseLeft + roomRight) / 2;
+
+            // Only the compact pill hugs its content; the plain centered mode keeps spanning the
+            // whole room between the slots and just centers the text inside it.
+            int target = desu.inugram.helpers.InuUtils.compactChatPill()
+                    ? (int) Math.ceil(inu_centeredTextWidth) + dp(INU_PILL_TEXT_SLACK_DP)
+                        + inu_getPillTextInsetLeft() + inu_getPillTextInsetRight()
+                    : roomRight - baseLeft;
+            target = Math.max(target, dp(INU_PILL_MIN_WIDTH_DP));
+            target = Math.min(target, roomRight - baseLeft);
+
+            // Snap on the first pass (and whenever the pill was collapsed) so the header does not
+            // unfold out of nothing every time a chat is opened; animate afterwards.
+            if (inu_animatorPillWidth.getFactor() <= 0f) {
+                inu_animatorPillWidth.forceFactor(target);
+            } else if (inu_animatorPillWidth.getToFactor() != target) {
+                inu_animatorPillWidth.animateTo(target);
+            }
+            final int drawn = Math.max(0, (int) inu_animatorPillWidth.getFactor());
+
+            inu_titlePillLeft = inu_placePill(centerX, target, leftLimit, roomRight);
+            inu_titlePillRight = inu_titlePillLeft + target;
+
+            leftDefault = inu_placePill(centerX, drawn, leftLimit, roomRight);
+            rightDefault = leftDefault + drawn;
+        } else {
+            // Not centered: the pill spans the whole room between the back button and the menu,
+            // and the container is left where its own margins put it, so the avatar and the text
+            // read left-aligned. Stock instead shrank the pill onto the container's measured width
+            // and then dragged the container into the middle of the free room - that is what made
+            // a header with every toggle off still look centered, and worse, look centered ONLY
+            // while the glass pill was visible to explain it (with classic UI on, inu_nonIsland
+            // paints the bar edge to edge and the indent had nothing left to justify it).
+            final int stockRightOffset = lerp(menuWidthWithPadding, Math.max(menuWidthWithPadding, p + s), chatAvatarContainer == null ? 0f : 1f - animatorAvatarContainerHasAvatar.getFloatValue());
+            final int stockLeft = lerp(hasBackButton ? s + p : 0, s + p, chatAvatarContainer == null ? 0f : 1f - animatorAvatarContainerHasAvatar.getFloatValue());
+            leftDefault = stockLeft;
+            rightDefault = width - stockRightOffset;
+            if (chatAvatarContainer != null && chatAvatarContainer.getLayoutParams() instanceof MarginLayoutParams) {
+                // Keep the stock inset from the pill edge to the avatar (p + dp(3)) so the avatar
+                // does not touch the back button's own pill, and nothing else.
+                final float translationX = leftDefault
+                    - ((MarginLayoutParams) chatAvatarContainer.getLayoutParams()).leftMargin
+                    - chatAvatarContainer.getLeftPadding()
+                    + p + dp(3);
+                chatAvatarContainer.setTranslationX(translationX);
+                chatAvatarContainer.setPivotX(chatAvatarContainer.getMeasuredWidth() / 2f - translationX);
+            }
+            inu_titlePillLeft = leftDefault;
+            inu_titlePillRight = rightDefault;
+            inu_animatorPillWidth.forceFactor(0);
+        }
+
+        inu_glassTitleLeft = leftDefault;
+        inu_glassTitleRight = rightDefault;
+        inu_glassTop = t;
+        inu_glassBottom = b;
+
+        // Only the centered pill drives the container's layout. The default bounds follow the
+        // menu-width animator and change every frame, so comparing them here would ask for a
+        // layout pass on each of those frames for nothing.
+        if (centered && (inu_titlePillLeft != prevPillLeft || inu_titlePillRight != prevPillRight)) {
+            inu_requestAvatarContainerLayout();
+        }
+    }
+
+    // Center a pill of the given width, then keep it clear of the back badge and the menu.
+    private int inu_placePill(int centerX, int pillWidth, int leftLimit, int rightLimit) {
+        int left = centerX - pillWidth / 2;
+        if (left + pillWidth > rightLimit) {
+            left = rightLimit - pillWidth;
+        }
+        if (left < leftLimit) {
+            left = leftLimit;
+        }
+        return left;
+    }
+
+    // The container measures and lays its text out against inu_titlePill*, so a pill that moved
+    // outside a layout pass (a new subtitle, the unread badge appearing) has to ask for one.
+    // Skipped while a layout pass is already pending, which is also what stops this from looping:
+    // the pill is a pure function of slot geometry and painted text width, so the pass it asks
+    // for recomputes the same rectangle and asks for nothing further.
+    private void inu_requestAvatarContainerLayout() {
+        final ChatAvatarContainer container = chatAvatarContainer;
+        if (container == null || container.isLayoutRequested() || isLayoutRequested()) {
+            return;
+        }
+        if (isInLayout() || container.isInLayout()) {
+            AndroidUtilities.runOnUIThread(container::requestLayout);
+        } else {
+            container.requestLayout();
+        }
+    }
+
