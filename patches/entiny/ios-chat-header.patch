Subject: Add an iOS-style centered chat header

---
 .../org/telegram/ui/ActionBar/ActionBar.java  | 38 ++++++++-
 .../java/org/telegram/ui/ChatActivity.java    | 20 +++++
 .../ui/Components/ChatAvatarContainer.java    | 85 ++++++++++++++++++-
 3 files changed, 137 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBar.java b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBar.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBar.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBar.java
@@ -59,6 +59,7 @@ import org.telegram.messenger.R;
 import org.telegram.messenger.SharedConfig;
 import org.telegram.ui.Adapters.FiltersView;
 import org.telegram.ui.Components.AnimatedEmojiDrawable;
+import org.telegram.ui.Components.AnimatedFloat;
 import org.telegram.ui.Components.BackupImageView;
 import org.telegram.ui.Components.ChatAvatarContainer;
 import org.telegram.ui.Components.CubicBezierInterpolator;
@@ -213,6 +214,19 @@ public class ActionBar extends FrameLayout implements FactorAnimator.Target, The
         this.chatAvatarContainer = chatAvatarContainer;
     }
 
+    // iOS-style centered chat header: pill hugs the avatar+title group instead of
+    // spanning the full back-button-to-menu width. See updateGlassBounds().
+    private final AnimatedFloat inu_iosHeaderPillWidth = new AnimatedFloat(this, 0, 320, CubicBezierInterpolator.EASE_OUT_QUINT);
+
+    public int getCenteredTitlePillPadding() {
+        // With the iOS header the avatar sits out in the menu slot, so the pill only has to
+        // wrap the title/subtitle text — it needs far less side padding than the avatar layout.
+        if (chatAvatarContainer != null && chatAvatarContainer.inu_isIosMenuSlotAvatar()) {
+            return dp(32);
+        }
+        return dp(72);
+    }
+
     public void setupGlass(BlurredBackgroundDrawableViewFactory factory, BlurredBackgroundColorProvider colorProvider) {
         setupGlass(factory, colorProvider, false);
     }
@@ -2389,8 +2403,28 @@ public class ActionBar extends FrameLayout implements FactorAnimator.Target, The
 
         final int menuWidthWithPadding = menuWidth + (hasForcedMenuWidth ? (menuWidth > 0 ? p : 0) : (int) (p * animatorHasMenuItems.getFloatValue()));
         final int rightOffset = menuWidthWithPadding;
-        final int leftDefault = hasBackButton ? s + p : 0;
-        final int rightDefault = width - rightOffset;
+        int leftDefault = hasBackButton ? s + p : 0;
+        int rightDefault = width - rightOffset;
+
+        if (desu.inugram.InuConfig.IOS_CHAT_HEADER.getValue() && chatAvatarContainer != null && chatAvatarContainer.isTitleCenteredMode()) {
+            final int avatarLeft = chatAvatarContainer.getCenteredAvatarLeft();
+            final int rightLimit = avatarLeft > 0 ? Math.min(rightDefault, avatarLeft - p) : rightDefault;
+            final int centerX = Math.round(chatAvatarContainer.getLeft() + chatAvatarContainer.getTitlesCenterX());
+            final int symRoom = Math.max(dp(48), 2 * Math.min(centerX - leftDefault, rightLimit - centerX));
+            final int target = Math.min(symRoom, Math.max(dp(136), chatAvatarContainer.getTitlesWidth() + getCenteredTitlePillPadding()));
+            final int pillWidth = Math.round(inu_iosHeaderPillWidth.set(target));
+            leftDefault = centerX - pillWidth / 2;
+            rightDefault = leftDefault + pillWidth;
+        } else if (desu.inugram.InuConfig.CENTER_TITLE_FIXED.getValue() && chatAvatarContainer != null && chatAvatarContainer.isTitleCenteredMode()) {
+            // "Fixed" centering (exteraGram-style): always sit at the screen's true horizontal
+            // midpoint, sized to content but NOT clamped against leftDefault/rightDefault's real
+            // back-button/menu edges the way the default branch above is - it can overlap a wide
+            // back button or a busy menu on narrow headers. That's the accepted tradeoff.
+            final int pillWidth = Math.max(dp(48), Math.min(width, chatAvatarContainer.getTitlesWidth() + getCenteredTitlePillPadding()));
+            final int centerX = width / 2;
+            leftDefault = centerX - pillWidth / 2;
+            rightDefault = leftDefault + pillWidth;
+        }
 
         inu_glassTitleLeft = leftDefault;
         inu_glassTitleRight = rightDefault;
