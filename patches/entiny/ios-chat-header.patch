+    // iOS-style centered chat header: pill hugs the avatar+title group instead of
+    // spanning the full back-button-to-menu width. See updateGlassBounds().
+    private final AnimatedFloat inu_iosHeaderPillWidth = new AnimatedFloat(this, 0, 320, CubicBezierInterpolator.EASE_OUT_QUINT);
+
+    public int getCenteredTitlePillPadding() {
+        // With the iOS header the avatar sits out in the menu slot, so the pill only has to
+        // wrap the title/subtitle text — it needs far less side padding than the avatar layout.
+        if (chatAvatarContainer != null && chatAvatarContainer.inu_isIosMenuSlotAvatar()) {
+            return dp(32);
+        }
+        return dp(72);
+    }
