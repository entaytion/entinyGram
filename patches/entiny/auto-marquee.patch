         titleTextView.setGravity(centerChatTitle ? Gravity.CENTER_HORIZONTAL : Gravity.LEFT);
@@ -303,7 +305,8 @@ public class ChatAvatarContainer extends FrameLayout implements FactorAnimator.T
             addView(animatedSubtitleTextView);
         } else {
             subtitleTextView = new SimpleTextConnectedView(context, subtitleTextLargerCopyView);
-            subtitleTextView.setEllipsizeByGradient(true);
+            subtitleTextView.setScrollNonFitText(marquee);
+            subtitleTextView.setEllipsizeByGradient(!marquee);
             subtitleTextView.setTextColor(getThemedColor(Theme.key_actionBarDefaultSubtitle));
             subtitleTextView.setTag(Theme.key_actionBarDefaultSubtitle);
             subtitleTextView.setTextSize(14);
@@ -688,15 +691,19 @@ public class ChatAvatarContainer extends FrameLayout implements FactorAnimator.T
         } else {
             availableWidth = width - dp((hasVisibleAvatar() ? 54 : 0) + (glassMode ? 24 : 16));
         }
+        boolean marquee = desu.inugram.InuConfig.CHAT_TITLE_MARQUEE.getValue();
         float baseSizePx = dp(glassMode ? 17.5f : 18);
         if (Math.abs(titleTextView.getTextPaint().getTextSize() - baseSizePx) > 0.5f) {
             titleTextView.setTextSizePx((int) baseSizePx);
         }
         avatarImageView.measure(MeasureSpec.makeMeasureSpec(dp(avatarSizeInDp) - 2, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(dp(avatarSizeInDp) - 2, MeasureSpec.EXACTLY));
-        titleTextView.setWidthWrapContent(!centerChatTitle);
+        // wrap_content sizing shrinks the view down to the actual text width, which is fine for
+        // static ellipsis but leaves the marquee scrolling inside a window only as wide as the
+        // text itself instead of the full row — force full width while marquee is active.
+        titleTextView.setWidthWrapContent(!centerChatTitle && !marquee);
         titleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, centerChatTitle ? MeasureSpec.EXACTLY : MeasureSpec.AT_MOST), MeasureSpec.makeMeasureSpec(dp(24 + 8), MeasureSpec.AT_MOST));
         if (subtitleTextView != null) {
-            subtitleTextView.setWidthWrapContent(!centerChatTitle);
+            subtitleTextView.setWidthWrapContent(!centerChatTitle && !marquee);
             subtitleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, centerChatTitle ? MeasureSpec.EXACTLY : MeasureSpec.AT_MOST), MeasureSpec.makeMeasureSpec(dp(20), MeasureSpec.AT_MOST));
         } else if (animatedSubtitleTextView != null) {
             animatedSubtitleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(dp(20), MeasureSpec.AT_MOST));
@@ -1033,6 +1040,9 @@ public class ChatAvatarContainer extends FrameLayout implements FactorAnimator.T
