@@ -663,12 +668,48 @@ public class ChatAvatarContainer extends FrameLayout implements FactorAnimator.T
 
     @Override
     protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
-        final int width = MeasureSpec.getSize(widthMeasureSpec);
-        final int availableWidth = width - dp((avatarImageView.getVisibility() == VISIBLE ? 54 : 0) + 16);
+        int width = MeasureSpec.getSize(widthMeasureSpec);
+        boolean centerChatTitle = isCenteredTitle();
+        if (centerChatTitle && actionBar != null) {
+            int targetPill = actionBar.inu_glassTitleRight - actionBar.inu_glassTitleLeft;
+            if (targetPill > 0) {
+                width = Math.min(width, targetPill);
+            }
+        }
+        final int availableWidth;
+        if (centerChatTitle) {
+            // Mirror onLayout's textLeftBound/textRightBound math so the EXACTLY-measured
+            // width used for ellipsizing matches the box the text is actually laid out into —
+            // otherwise long subtitles (e.g. member count + online) get visually clipped
+            // instead of ellipsized because the layout box in onLayout is narrower than this.
+            boolean rightAvatar = isRightAvatar();
+            int avatarW = hasVisibleAvatar() ? dp(avatarSizeInDp) - 2 : 0;
+            int inset = hasVisibleAvatar()
+                    ? (1 + leftPadding + avatarW + dp(4))
+                    : dp(rightAvatar ? (glassMode ? 14 : 10) : (glassMode ? 20 : 16));
+            availableWidth = Math.max(0, width - 2 * inset - rightAvatarPadding);
+        } else {
+            availableWidth = width - dp((hasVisibleAvatar() ? 54 : 0) + (glassMode ? 24 : 16));
+        }
+        float baseSizePx = dp(glassMode ? 17.5f : 18);
+        if (Math.abs(titleTextView.getTextPaint().getTextSize() - baseSizePx) > 0.5f) {
+            titleTextView.setTextSizePx((int) baseSizePx);
+        }
         avatarImageView.measure(MeasureSpec.makeMeasureSpec(dp(avatarSizeInDp) - 2, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(dp(avatarSizeInDp) - 2, MeasureSpec.EXACTLY));
-        titleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, MeasureSpec.AT_MOST), MeasureSpec.makeMeasureSpec(dp(24 + 8), MeasureSpec.AT_MOST));
+        // Never size these wrap_content (this matches stock). SimpleTextView#setText goes through
+        // recreateLayoutMaybe(), which — once the view has been laid out once — rebuilds the layout
+        // against the CURRENT getMaxTextWidth() and deliberately does NOT requestLayout(). With
+        // wrap_content the measured width is min(availableWidth, textWidth), i.e. the width of
+        // whatever text was set at the last measure pass. A later, longer subtitle (e.g. "14
+        // members" -> "14 members, 2 online") is then clipped/gradient-faded at the previous,
+        // shorter text's width and nothing ever re-measures it. Measuring to the full availableWidth
+        // keeps the drawing window at the real box width; the layout bounds below and getVisualWidth()
+        // do not depend on this view being shrink-wrapped.
+        titleTextView.setWidthWrapContent(false);
+        titleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, centerChatTitle ? MeasureSpec.EXACTLY : MeasureSpec.AT_MOST), MeasureSpec.makeMeasureSpec(dp(24 + 8), MeasureSpec.AT_MOST));
         if (subtitleTextView != null) {
-            subtitleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, MeasureSpec.AT_MOST), MeasureSpec.makeMeasureSpec(dp(20), MeasureSpec.AT_MOST));
+            subtitleTextView.setWidthWrapContent(false);
+            subtitleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, centerChatTitle ? MeasureSpec.EXACTLY : MeasureSpec.AT_MOST), MeasureSpec.makeMeasureSpec(dp(20), MeasureSpec.AT_MOST));
         } else if (animatedSubtitleTextView != null) {
             animatedSubtitleTextView.measure(MeasureSpec.makeMeasureSpec(availableWidth, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(dp(20), MeasureSpec.AT_MOST));
         }
