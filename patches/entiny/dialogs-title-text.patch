From: Oleksii Kulinich <entaytion@gmail.com>
Date: Tue, 1 Sep 2026 11:15:02 +0300
Subject: Show custom title text on the dialogs list, with an option for the archive

---
 .../java/org/telegram/ui/DialogsActivity.java | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
@@ -1564,6 +1564,14 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
                                     viewPages[0].dialogsAdapter.resume();
                                     viewPages[1].dialogsAdapter.pause();
                                 }
+                                // Whichever way this settles -- committed to the target page, or
+                                // snapped back to the original one (backAnimation) -- viewPages[0]
+                                // is now authoritative again; re-assert the title from it so a
+                                // cancelled swipe doesn't leave the target folder's name showing.
+                                java.util.ArrayList<MessagesController.DialogFilter> inu_settledFilters = getMessagesController().getDialogFilters();
+                                if (viewPages[0].selectedType >= 0 && viewPages[0].selectedType < inu_settledFilters.size()) {
+                                    inu_updateFolderTitle(inu_settledFilters.get(viewPages[0].selectedType));
+                                }
                                 viewPages[1].setVisibility(View.GONE);
                                 showScrollbars(true);
                                 tabsAnimationInProgress = false;
@@ -3049,6 +3057,10 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
     private Drawable premiumStar;
 
     public void updateStatus(TLRPC.User user, boolean animated) {
+        if (!desu.inugram.helpers.security.ParanoiaHelper.isDisguised() && actionBar != null &&
+                (folderId == 0 || desu.inugram.InuConfig.DIALOGS_TITLE_TEXT_OVERRIDE_ARCHIVE.getValue())) {
+            actionBar.setTitle(desu.inugram.helpers.chat.ChatHelper.getDialogsTitle(currentAccount), statusDrawable);
+        }
         if (dialogStoriesCell != null) {
             dialogStoriesCell.updateStatus(user, animated);
         }
@@ -3723,6 +3735,10 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
                         checkListLoad(viewPages[0]);
                         viewPages[0].dialogsAdapter.resume();
                         viewPages[1].dialogsAdapter.pause();
+                        ArrayList<MessagesController.DialogFilter> inu_settledFilters = getMessagesController().getDialogFilters();
+                        if (viewPages[0].selectedType >= 0 && viewPages[0].selectedType < inu_settledFilters.size()) {
+                            inu_updateFolderTitle(inu_settledFilters.get(viewPages[0].selectedType));
+                        }
                     }
                 }
 
@@ -6939,6 +6955,22 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
         switchToCurrentSelectedMode(false);
     }
 
+    // Re-asserted both when a folder swipe/tap starts (switchToCurrentSelectedMode) and again once
+    // it actually settles (onPageScrolled progress==1) -- calling it twice is harmless, and doing
+    // it at settle-time is what stops a stale filter's name from flashing if some unrelated update
+    // (e.g. a message arriving mid-swipe) races the title back to viewPages[0] before the swap.
+    private void inu_updateFolderTitle(MessagesController.DialogFilter filter) {
+        if (actionBar == null || folderId != 0 || communityId != 0 || filter == null) {
+            return;
+        }
+        if (desu.inugram.InuConfig.DIALOGS_TITLE_TEXT.getValue() != desu.inugram.InuConfig.DialogsTitleTextItem.FOLDER) {
+            return;
+        }
+        actionBar.setTitle(filter.isDefault()
+                ? desu.inugram.helpers.chat.ChatHelper.getDialogsTitle(currentAccount)
+                : desu.inugram.helpers.dialogs.FolderHelper.getTabInfo(filter).first);
+    }
+
     public void switchToCurrentSelectedMode(boolean animated) {
         for (int a = 0; a < viewPages.length; a++) {
             viewPages[a].listView.stopScroll();
@@ -6965,6 +6997,17 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
             viewPages[1].isLocked = filter.locked;
         }
 
+        if (animated || (!startedTracking && !tabsAnimationInProgress)) {
+            // animated==true means this call is itself the transition kicking off (tab tap /
+            // drag start), so it must win immediately. animated==false can also arrive from an
+            // unrelated resync (updateFilterTabs() reacting to a dialog/counter update) that
+            // fires *during* an in-flight swipe/fling -- in that case `a` is still 0, the
+            // not-yet-swapped outgoing page, so applying it here would flash the old folder's
+            // name mid-transition. Skip it; the settle-time update in onPageScrolled will apply
+            // the correct (new) folder once the transition actually finishes.
+            inu_updateFolderTitle(filter);
+        }
+
         viewPages[a].dialogsAdapter.setDialogsType(viewPages[a].dialogsType);
         viewPages[a].layoutManager.scrollToPositionWithOffset(viewPages[a].dialogsType == DIALOGS_TYPE_DEFAULT && hasHiddenArchive() && viewPages[a].archivePullViewState == ARCHIVE_ITEM_STATE_HIDDEN ? 1 : 0, (int) scrollYOffset);
         checkListLoad(viewPages[a]);
