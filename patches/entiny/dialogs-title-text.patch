+    // Re-asserted both when a folder swipe/tap starts (switchToCurrentSelectedMode) and again once
+    // it actually settles (onPageScrolled progress==1) -- calling it twice is harmless, and doing
+    // it at settle-time is what stops a stale filter's name from flashing if some unrelated update
+    // (e.g. a message arriving mid-swipe) races the title back to viewPages[0] before the swap.
+    private void inu_updateFolderTitle(MessagesController.DialogFilter filter) {
+        if (actionBar == null || folderId != 0 || communityId != 0 || filter == null) {
+            return;
+        }
+        if (desu.inugram.InuConfig.DIALOGS_TITLE_TEXT.getValue() != desu.inugram.InuConfig.DialogsTitleTextItem.FOLDER) {
+            return;
+        }
+        actionBar.setTitle(filter.isDefault()
+                ? desu.inugram.helpers.chat.ChatHelper.getDialogsTitle(currentAccount)
+                : desu.inugram.helpers.dialogs.FolderHelper.getTabInfo(filter).first);
+    }
