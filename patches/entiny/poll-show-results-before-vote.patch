From: Oleksii Kulinich <entaytion@gmail.com>
Date: Fri, 28 Aug 2026 13:21:05 +0300
Subject: [*] show poll results before voting

---
 .../org/telegram/ui/Cells/ChatMessageCell.java    | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -6844,7 +6844,8 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
             if (!pollChanged && newResults != lastPollResults) {
                 pollChanged = true;
             }
-            if (!pollChanged && (messageObject.forceShowPollResults != pollResultsPreview)) {
+            final boolean newPollResultsPreview = messageObject.forceShowPollResults || desu.inugram.helpers.chat.PollResultsHelper.canShowBeforeVote(messageObject);
+            if (!pollChanged && (newPollResultsPreview != pollResultsPreview)) {
                 pollChanged = true;
             }
             if (lastPoll != newPoll && (lastPoll != null && lastPoll.closed) != newPoll.closed) {
@@ -6857,7 +6858,7 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
             animatePollAvatars = false;
             if (pollChanged && attachedToWindow) {
                 pollAnimationProgressTime = 0.0f;
-                if ((pollVoted || pollResultsPreview) && !(messageObject.isVoted() || messageObject.forceShowPollResults)) {
+                if ((pollVoted || pollResultsPreview) && !(messageObject.isVoted() || newPollResultsPreview)) {
                     pollUnvoteInProgress = true;
                 }
                 animatePollAvatars = lastPollResultsVoters == 0 || lastPollResultsVoters != 0 && newVoters == 0;
@@ -11389,7 +11390,7 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
             total_voters = media.results.total_voters;
             timerTransitionProgress = media.poll.close_date - ConnectionsManager.getInstance(currentAccount).getCurrentTime() < 60 ? 0.0f : 1.0f;
             pollClosed = media.poll.closed;
-            pollResultsPreview = messageObject.forceShowPollResults;
+            pollResultsPreview = messageObject.forceShowPollResults || desu.inugram.helpers.chat.PollResultsHelper.canShowBeforeVote(messageObject);
             pollHideResults = media.poll.hide_results_until_close;
             title = media.poll.question;
             if (pollClosed) {
@@ -12021,7 +12022,9 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
         }
 
         final TLRPC.PollResults results = media.results;
-        final boolean canViewHiddenResultsWithoutVote = !pollVoted && !pollClosed && pollHasResults && results != null && results.total_voters != 0 && media.poll.creator; //pollHideResults;
+        final boolean showPollResultsBeforeVote = desu.inugram.InuConfig.SHOW_POLL_RESULTS_BEFORE_VOTE.getValue();
+        final boolean canViewHiddenResultsWithoutVote = !pollVoted && !pollClosed && pollHasResults && results != null && results.total_voters != 0 && (media.poll.creator || desu.inugram.helpers.chat.PollResultsHelper.canShowBeforeVote(messageObject)); //pollHideResults;
+        final boolean canViewPollResultsAfterVote = showPollResultsBeforeVote && pollVoted && results != null && results.total_voters != 0 && (!pollHideResults || pollHasResults || pollClosed);
         final boolean canVote = !pollVoted && !pollClosed && !pollHasVoteRestrictions;
         final boolean isAnonymousPoll = !media.poll.public_voters;
 
@@ -12030,8 +12033,8 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
             instantViewType = INSTANT_BUTTON_TYPE_ADD_OPTION;
             instantViewText = getString(R.string.PollButtonSave);
         } else {
-            if (canViewHiddenResultsWithoutVote && !(media.poll.multiple_choice && canVote && hasCheckedCheckboxes)) {
-                if (isAnonymousPoll) {
+            if ((canViewHiddenResultsWithoutVote || canViewPollResultsAfterVote) && !(media.poll.multiple_choice && canVote && hasCheckedCheckboxes)) {
+                if (isAnonymousPoll && media.poll.creator && !pollVoted) {
                     if (messageObject.forceShowPollResults) {
                         instantViewType = INSTANT_BUTTON_TYPE_BACK_TO_VOTE;
                         instantViewText = AndroidUtilities.replaceArrows(getString(R.string.PollViewBack), false, -dp(8f / 3f), 0, 1.0f);
