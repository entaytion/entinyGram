         final int searchEndMargin = showSearch ? dp(4) : 0;
         final int containerPadding = tabsBarContainer.getPaddingLeft() + tabsBarContainer.getPaddingRight();
         final int outerInset = dp(Math.min(DialogsActivity.MAIN_TABS_MARGIN, 6));
@@ -1244,6 +1244,7 @@ public class MainTabsActivity extends ViewPagerActivity implements NotificationC
         ThemeDescription.ThemeDescriptionDelegate cellDelegate = this::blur3_updateColors;
         themeDescriptions.add(new ThemeDescription(null, 0, null, null, null, cellDelegate, Theme.key_windowBackgroundWhite));
         themeDescriptions.add(new ThemeDescription(null, 0, null, null, null, cellDelegate, Theme.key_dialogBackground));
+        themeDescriptions.add(new ThemeDescription(null, 0, null, null, null, cellDelegate, Theme.key_glass_tabUnselected));
 
         return themeDescriptions;
     }
