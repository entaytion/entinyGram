 .../src/main/java/org/telegram/ui/MainTabsActivity.java      | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/MainTabsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/MainTabsActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/MainTabsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/MainTabsActivity.java
@@ -489,7 +489,7 @@ public class MainTabsActivity extends ViewPagerActivity implements NotificationC
         tabsBarContainer.addView(tabsView, new LinearLayout.LayoutParams(dp(tabsViewWidth), LayoutHelper.MATCH_PARENT));
         if (searchTabContainer != null) {
             LinearLayout.LayoutParams searchParams = new LinearLayout.LayoutParams(dp(52), dp(52));
-            searchParams.setMarginStart(0);
+            searchParams.setMarginStart(-dp(Math.max(0, mainTabsMargin - 4)));
             searchParams.setMarginEnd(dp(4));
