From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Oleksii \"Entaytion\" Kulinich" <entaytion@gmail.com>
Date: Sun, 2 Aug 2026 13:44:28 +0300
Subject: Add ABI filter toggle driven by ABI_FILTERS env var

---
 TMessagesProj/build.gradle     | 7 ++++++-
 TMessagesProj_App/build.gradle | 7 ++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -117,7 +117,12 @@ android {
         targetSdkVersion 35
 
         ndk {
-            abiFilters "arm64-v8a"
+            def filters = System.getenv('ABI_FILTERS')
+            if (filters == null || filters.isEmpty()) {
+                abiFilters "arm64-v8a"
+            } else if (filters != 'all') {
+                abiFilters filters.split(',') as String[]
+            }
         }
 
         externalNativeBuild {
diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -103,7 +103,12 @@ android {
         ndkVersion "27.2.12479018"
 
         ndk {
-            abiFilters "arm64-v8a"
+            def filters = System.getenv('ABI_FILTERS')
+            if (filters == null || filters.isEmpty()) {
+                abiFilters "arm64-v8a"
+            } else if (filters != 'all') {
+                abiFilters filters.split(',') as String[]
+            }
         }
 
         externalNativeBuild {
